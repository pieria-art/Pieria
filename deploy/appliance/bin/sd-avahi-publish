#!/usr/bin/env python3
"""sd-avahi-publish — (re)write the `_pieria._tcp` mDNS record from the running app's identity.

Avahi service files are static XML, but the TXT values (app version, server_id) change: the version on
every update, the server_id when a backup is restored onto a new card. So this regenerates the file:
at boot (sd-avahi-publish.service), after a successful update-app (sd-update), and on install.

Where the values come from: the app's UNAUTHENTICATED loopback route GET /api/health/identity.
Least-privileged choice — root never reads data/ (so no sd-mailbox surface), and the values are
broadcast on the LAN by this very record, so exposing them there discloses nothing new.

Fails closed: if the app does not answer within --wait seconds, or answers with anything that is not a
well-formed version + UUID, the existing file is left untouched and we exit 1 (never advertise a made-up
server_id — the Home Assistant integration keys its device on it).

Usage: sd-avahi-publish [--url http://127.0.0.1:8000] [--out /etc/avahi/services/pieria-api.service] [--wait 90]
"""
from __future__ import annotations

import argparse
import json
import os
import re
import sys
import tempfile
import time
import urllib.parse
import urllib.request
from xml.sax.saxutils import escape

_VERSION_RE = re.compile(r"^[0-9A-Za-z][0-9A-Za-z.+_-]{0,63}$")
_UUID_RE = re.compile(r"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$")

TEMPLATE = """<?xml version="1.0" standalone='no'?>
<!DOCTYPE service-group SYSTEM "avahi-service.dtd">
<!-- GENERATED by sd-avahi-publish — do not edit; rewritten at boot and after each update. -->
<service-group>
  <name replace-wildcards="yes">Pieria API on %h</name>
  <service>
    <type>_pieria._tcp</type>
    <port>{port}</port>
    <txt-record>version={version}</txt-record>
    <txt-record>server_id={server_id}</txt-record>
    <txt-record>path=/api/v1</txt-record>
  </service>
</service-group>
"""


def render(version: str, server_id: str, port: int) -> str:
    """The service file for these values. Raises ValueError on anything malformed. Values are validated
    AND XML-escaped (belt and braces: the file is root-installed and avahi parses it as XML)."""
    version, server_id = str(version), str(server_id)
    if not _VERSION_RE.match(version):
        raise ValueError(f"malformed version: {version!r}")
    if not _UUID_RE.match(server_id):
        raise ValueError(f"malformed server_id: {server_id!r}")
    if not (isinstance(port, int) and 0 < port < 65536):
        raise ValueError(f"bad port: {port!r}")
    return TEMPLATE.format(port=port, version=escape(version), server_id=escape(server_id.lower()))


class _NoRedirect(urllib.request.HTTPRedirectHandler):
    """The app runs in a container root cannot trust: a 3xx must never steer root's request elsewhere
    (blind SSRF). Refuse every redirect — it surfaces as an HTTPError, i.e. a failed attempt."""

    def redirect_request(self, *args, **kwargs):
        return None


#: No proxy handler either: an environment http_proxy must not carry root's loopback request off-box.
_OPENER = urllib.request.build_opener(urllib.request.ProxyHandler({}), _NoRedirect)
_LOOPBACK = {"127.0.0.1", "localhost", "::1"}


def check_loopback(url: str) -> None:
    """Root only ever talks to the local app. Anything else (including a hostile SD_AVAHI_URL) is refused."""
    u = urllib.parse.urlparse(url)
    if u.scheme != "http" or u.hostname not in _LOOPBACK:
        raise ValueError(f"refusing non-loopback url: {url!r}")


def fetch_identity(url: str, wait: float) -> dict:
    check_loopback(url)
    deadline = time.monotonic() + wait
    last: Exception | None = None
    while True:
        try:
            with _OPENER.open(url.rstrip("/") + "/api/health/identity", timeout=5) as r:
                if r.status != 200:   # any 3xx that slipped through is a failure, never followed
                    raise ValueError(f"unexpected status {r.status}")
                data = json.loads(r.read(4096))
            if isinstance(data, dict):
                return data
            last = ValueError("identity is not an object")
        except Exception as e:  # noqa: BLE001 — retry on anything until the deadline
            last = e
        if time.monotonic() >= deadline:
            raise RuntimeError(f"no identity from {url}: {last}")
        time.sleep(3)


def write_if_changed(path: str, content: str) -> bool:
    try:
        with open(path) as f:
            if f.read() == content:
                return False
    except FileNotFoundError:
        pass
    d = os.path.dirname(path) or "."
    fd, tmp = tempfile.mkstemp(dir=d, prefix=".pieria-api.")
    try:
        with os.fdopen(fd, "w") as f:
            f.write(content)
        os.chmod(tmp, 0o644)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise
    return True


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--url", default=os.environ.get("SD_AVAHI_URL", "http://127.0.0.1:8000"))
    ap.add_argument("--out", default="/etc/avahi/services/pieria-api.service")
    ap.add_argument("--wait", type=float, default=90.0)
    a = ap.parse_args(argv)
    port = urllib.parse.urlparse(a.url).port or 8000
    try:
        ident = fetch_identity(a.url, a.wait)
        content = render(ident.get("version", ""), ident.get("server_id", ""), port)
        changed = write_if_changed(a.out, content)
    except (RuntimeError, ValueError, OSError) as e:
        print(f"sd-avahi-publish: {e}", file=sys.stderr)
        return 1
    print(f"sd-avahi-publish: {'wrote' if changed else 'unchanged'} {a.out}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
