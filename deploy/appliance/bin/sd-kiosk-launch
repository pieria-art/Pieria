#!/usr/bin/env bash
# sd-kiosk-launch
#
# Read the appliance config, build the Canvas URL, wait for the server, then
# run Chromium fullscreen inside the `cage` kiosk compositor. Relaunches the
# session if it ever exits. Invoked from the kiosk user's login shell on tty1.
set -u

find_conf() {
  for p in /boot/firmware/pieria.conf /boot/pieria.conf /etc/pieria.conf; do
    [ -r "$p" ] && { printf '%s\n' "$p"; return 0; }
  done
  return 1
}

CONF="$(find_conf)" || {
  echo "sd-kiosk-launch: no pieria.conf found on the boot partition or /etc" >&2
  exit 1
}
# shellcheck disable=SC1090
. "$CONF"

SERVER_URL="${SERVER_URL:-http://localhost:8000}"
DISPLAY_ID="${DISPLAY_ID:-default}"
WAIT_TIMEOUT="${WAIT_TIMEOUT:-0}"
ROTATE="${ROTATE:-}"             # blank/normal = landscape; 90|180|270 for portrait/rotated panels
OUTPUT="${OUTPUT:-HDMI-A-1}"     # which HDMI port to rotate (HDMI-A-1 = nearest USB-C on a Pi 5)

# Build the Canvas URL. Hierarchical overrides (mode, cycle_time) are optional;
# blank values are omitted so the playlist/server defaults win.
URL="${SERVER_URL%/}/?display=${DISPLAY_ID}"
[ -n "${MODE:-}" ]       && URL="${URL}&mode=${MODE}"
[ -n "${CYCLE_TIME:-}" ] && URL="${URL}&cycle_time=${CYCLE_TIME}"

CHROME_BIN="$(command -v chromium-browser || command -v chromium || true)"
if [ -z "$CHROME_BIN" ]; then
  echo "sd-kiosk-launch: chromium not found (expected chromium-browser or chromium)" >&2
  exit 1
fi

# Chromium kiosk flags. NOTE: the Wayland/Ozone flags below should be confirmed
# on the target image — some Chromium builds auto-detect Wayland under cage and
# need neither; others require both. See deploy/appliance/README.md.
CHROME_FLAGS=(
  --kiosk
  --noerrdialogs
  --disable-infobars
  --incognito
  --no-first-run
  --disable-session-crashed-bubble
  --check-for-update-interval=31536000
  --enable-features=UseOzonePlatform
  --ozone-platform=wayland
)

# Decide what Chromium opens FIRST. If the splash page is installed, paint it
# immediately — it shows the admin URL and self-redirects to the canvas once the
# server answers — so a fresh owner reads the address off the screen instead of
# staring at black. If it's NOT installed (older image), fall back to the original
# behavior: block until the server is reachable, then open the canvas directly.
TARGET="$URL"
# Setup mode wins outright. sd-setup-boot / sd-net-recover drop this file while the Pieria-Setup AP is
# up; the normal splash below would render an admin URL from the PLACEHOLDER SERVER_URL and tell the
# owner to visit an address that does not exist (ADR-058). It is on /run, so it vanishes on reboot —
# a configured box can never be stuck showing it.
SETUP_SPLASH="/run/sd-setup/setup-splash.html"
# An UNCONFIGURED box must never be shown the normal splash, because that splash confidently prints an
# admin address derived from the placeholder conf ("http://192.168.1.50:8000", "living_room"). Checking
# for the setup splash exactly once is not enough: sd-setup.service is Type=simple, so its
# `Before=getty@tty1.service` is satisfied the moment it forks, and the kiosk can arrive here seconds
# before sd-setup-boot has written the file (measured: 2.1s early, first full gramps run 2026-07-22).
#
# So decide from the CONFIG, which is authoritative and race-free, and only then wait for the artwork:
# if this box is not configured we are in setup mode by definition, and we wait for the real splash
# rather than falling through to a wrong address.
_sd_configured() {
  # Same rule as common.sh's sd_is_configured — the shipped placeholder counts as "not set yet".
  # Duplicated deliberately: this script runs as the unprivileged kiosk user at login and must not
  # depend on sourcing files under /usr/local/share.
  [ -r "$CONF" ] || return 1
  [ -n "${SERVER_URL:-}" ] && [ -n "${DISPLAY_ID:-}" ] || return 1
  [ "${DISPLAY_ID}" = "living_room" ] && [ "${SERVER_URL}" = "http://192.168.1.50:8000" ] && return 1
  return 0
}

if [ -r "$SETUP_SPLASH" ]; then
  exec_kiosk_target="file://$SETUP_SPLASH"
elif ! _sd_configured; then
  # Setup mode, splash not written yet. Wait for it — bounded, so a box that somehow never writes one
  # still reaches a screen instead of hanging on a black display forever.
  echo "sd-kiosk-launch: unconfigured box — waiting for the setup splash before painting anything." >&2
  _waited=0
  while [ "$_waited" -lt 30 ]; do
    [ -r "$SETUP_SPLASH" ] && break
    sleep 1; _waited=$((_waited + 1))
  done
  if [ -r "$SETUP_SPLASH" ]; then
    echo "sd-kiosk-launch: setup splash appeared after ${_waited}s." >&2
    exec_kiosk_target="file://$SETUP_SPLASH"
  else
    # Still nothing. Say something true rather than something precise-and-wrong: the placeholder
    # address is worse than no address, because the owner will go and try it.
    echo "sd-kiosk-launch: no setup splash after ${_waited}s — painting a generic setup notice." >&2
    _fallback="${XDG_RUNTIME_DIR:-/tmp}/sd-setup-fallback.html"
    cat > "$_fallback" <<'FALLBACK'
<meta charset="utf-8"><title>Pieria — setup</title>
<style>html,body{height:100%;margin:0;background:#111;color:#eee;
font:400 2.2vw/1.5 system-ui,-apple-system,Segoe UI,Roboto,sans-serif;
display:flex;align-items:center;justify-content:center;text-align:center}
div{max-width:70%} b{font-size:3.2vw;display:block;margin-bottom:.6em}</style>
<div><b>This Pieria needs setting up</b>
Join the <b style="display:inline;font-size:inherit">Pieria-Setup</b> Wi-Fi network
from your phone, and a setup page will open automatically.</div>
FALLBACK
    exec_kiosk_target="file://$_fallback"
  fi
fi
SPLASH_SRC="/usr/local/share/pieria/sd-splash.html"
if [ -n "${exec_kiosk_target:-}" ]; then
  TARGET="$exec_kiosk_target"
elif [ -r "$SPLASH_SRC" ]; then
  IP="$(hostname -I 2>/dev/null | awk '{print $1}')"
  HOSTL="$(hostname 2>/dev/null).local"
  ADMIN_URL="${SERVER_URL%/}/admin"
  # All-in-one points SERVER_URL at localhost, which other devices can't reach —
  # rewrite the DISPLAYED admin URL to this box's <hostname>.local so it's usable.
  case "$SERVER_URL" in
    *localhost*|*127.0.0.1*)
      PORT="$(printf '%s\n' "$SERVER_URL" | sed -n 's@.*:\([0-9]\{2,5\}\).*@\1@p')"
      [ -z "$PORT" ] && PORT=8000
      ADMIN_URL="http://${HOSTL}:${PORT}/admin"
      ;;
  esac
  # Escape sed-special chars (& \ #) in values — the canvas URL can carry &mode=…
  esc() { printf '%s' "$1" | sed -e 's/[\\&#]/\\&/g'; }
  SPLASH="${XDG_RUNTIME_DIR:-/tmp}/sd-splash.html"
  if sed \
      -e "s#__SERVER_URL__#$(esc "$SERVER_URL")#g" \
      -e "s#__CANVAS_URL__#$(esc "$URL")#g" \
      -e "s#__ADMIN_URL__#$(esc "$ADMIN_URL")#g" \
      -e "s#__HOSTNAME_LOCAL__#$(esc "$HOSTL")#g" \
      -e "s#__IP__#$(esc "$IP")#g" \
      -e "s#__DISPLAY_ID__#$(esc "$DISPLAY_ID")#g" \
      "$SPLASH_SRC" > "$SPLASH" 2>/dev/null; then
    TARGET="file://$SPLASH"
  fi
else
  # Don't paint Chromium until the server is reachable (0 = wait forever).
  sd-wait-for-server "$SERVER_URL" "$WAIT_TIMEOUT" || true
fi

# What cage runs. For a portrait/rotated panel we rotate at the COMPOSITOR (the
# responsive Canvas then just fills the rotated viewport — pixel-exact, no panel
# scaling). cage itself has no rotation flag, so we apply it with wlr-randr inside
# the session. CRUCIAL: the transform must be RE-ASSERTED, not set once — a display
# power-cycle (e.g. the TV's own sleep timer) drops the HDMI sink and the output
# re-hotplugs on wake with wlroots' default (identity) transform, reverting a
# portrait panel to sideways landscape. So we background `sd-rotate-keep` in the
# session: it re-applies the transform whenever it drifts (covering both the
# cold-boot race and every sleep/wake). The kernel `rotate=` cmdline option only
# rotates the text console, NOT the compositor, so it is deliberately not used here.
APP=( "$CHROME_BIN" "${CHROME_FLAGS[@]}" "$TARGET" )
if [ -n "$ROTATE" ] && [ "$ROTATE" != "normal" ]; then
  if command -v wlr-randr >/dev/null 2>&1; then
    APP=( bash -c 'sd-rotate-keep "$1" "$2" & shift 2; exec "$@"' \
          _ "$OUTPUT" "$ROTATE" "$CHROME_BIN" "${CHROME_FLAGS[@]}" "$TARGET" )
  else
    echo "sd-kiosk-launch: ROTATE=$ROTATE set but wlr-randr is not installed; running unrotated" >&2
  fi
fi

# Crash-recovery: if cage or Chromium exits, relaunch after a short pause.
while true; do
  echo "sd-kiosk-launch: starting cage -> $TARGET (rotate=${ROTATE:-normal})" >&2
  cage -- "${APP[@]}" || true
  echo "sd-kiosk-launch: session exited, restarting in 3s" >&2
  sleep 3
done
