#!/usr/bin/env bash
# sd-os-schedule — the weekly unattended OS upgrade, if the owner opted in (ADR-119).
#
# Run by sd-os-upgrade.timer. It does NOT upgrade anything itself: it drops the same request.json
# that the GUI button writes, so the work flows through sd-update's `update-system` arm and produces
# identical logging, identical status, and one code path to reason about.
#
# Two belts, because this one reboots a box with nobody watching:
#   1. it refuses unless the CONF says weekly — so a timer left enabled by a stale drop-in, or by an
#      installer re-run, still cannot upgrade a box whose owner turned the schedule off;
#   2. it refuses while any bridge action is queued or running, rather than queueing behind it.
#
# Usage: sd-os-schedule <CONF> <REPO_ROOT>
set -u

CONF="${1:-/boot/firmware/pieria.conf}"
[ -e "$CONF" ] || CONF="/boot/pieria.conf"
REPO_ROOT="${2:-}"
if [ -z "$REPO_ROOT" ]; then
  echo "sd-os-schedule: REPO_ROOT argument required" >&2
  exit 1
fi

# shellcheck disable=SC1090
[ -r "$CONF" ] && . "$CONF" 2>/dev/null || true
if [ "${OS_UPDATE_SCHEDULE:-off}" != "weekly" ]; then
  logger -t sd-os-schedule "schedule is '${OS_UPDATE_SCHEDULE:-off}' — not weekly, nothing to do" 2>/dev/null || true
  exit 0
fi

# L6/ADR-119: data/appliance/ is writable by the unprivileged container (uid 1000), and can even be
# REPLACED by it with a symlink to somewhere else entirely — a bare `mkdir -p`/`chown`/`open(...,"w")`
# BY PATH would create the dir (harmless) or follow the symlink and read/write/chown whatever it points
# to, as root. Every touch of that directory goes through sd-mailbox, which opens data/ then "appliance"
# with O_NOFOLLOW and refuses closed if that fails.
BINDIR="$(dirname "$(readlink -f "$0")")"
SD_MAILBOX_BIN="${SD_MAILBOX_BIN:-$BINDIR/sd-mailbox}"
mbox() { "$SD_MAILBOX_BIN" --repo-root "$REPO_ROOT" "$@"; }
mbox chown-dir 2>/dev/null || true

# Don't stack on top of whatever the owner (or another timer) already started.
BUSY="$(mbox read status.json 2>/dev/null | python3 -c "import json,sys
try:
    d = json.load(sys.stdin)
    print('1' if d.get('state') in ('queued', 'running') else '0')
except Exception:
    print('0')" 2>/dev/null || echo 0)"
if [ "$BUSY" = "1" ]; then
  logger -t sd-os-schedule "an action is already in flight — skipping this week" 2>/dev/null || true
  exit 0
fi

# Status FIRST, then the request — the same ordering the endpoint uses, so the .path trigger always
# finds a status to report. `source: schedule` is what lets the UI say why an upgrade it never asked
# for is running. Content is built here (pure computation, no path) and handed to sd-mailbox to place
# — mode/owner are set on the open fd inside the helper, never by a chmod/chown that follows a symlink.
NOW="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
NONCE="$(python3 -c 'import secrets; print(secrets.token_hex(8))')"
SD_NOW="$NOW" SD_NONCE="$NONCE" python3 -c '
import json, os
print(json.dumps({"state": "queued", "action": "update-system", "nonce": os.environ["SD_NONCE"],
                   "message": "queued by the weekly schedule", "log_tail": [],
                   "queued_at": os.environ["SD_NOW"]}))
' | mbox write status.json --mode 0644 --owner 1000:1000

SD_NOW="$NOW" SD_NONCE="$NONCE" python3 -c '
import json, os
print(json.dumps({"action": "update-system", "requested_at": os.environ["SD_NOW"],
                   "nonce": os.environ["SD_NONCE"], "source": "schedule"}))
' | mbox write request.json --mode 0644 --owner 1000:1000

logger -t sd-os-schedule "queued the weekly system update" 2>/dev/null || true
