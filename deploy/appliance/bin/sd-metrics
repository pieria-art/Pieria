#!/usr/bin/env bash
# sd-metrics
#
# Writes the one host metric the containerized app CANNOT read itself — the Pi
# throttle/under-voltage bitmask from `vcgencmd` (a host binary backed by /dev/vcio,
# absent inside the unprivileged container). Drops it as JSON into the bind-mounted
# data/appliance/ dir, where host_health.read_throttled() picks it up. Run on a short
# systemd timer (sd-metrics.timer). Everything else (load/temp/disk/mem/uptime) the
# app reads directly from /proc + /sys, so it is intentionally NOT duplicated here.
#
# It also keeps data/appliance/conf.json in step with the boot conf (ADR-119). The app cannot read
# /boot/firmware — it is outside the container — so that mirror is how the admin UI knows the
# device's settings. sd-update re-exports it after every edit; doing it here as well is what makes a
# HAND edit of the conf (SD card in a laptop) show up in the UI instead of silently disagreeing.
#
# Usage: sd-metrics <REPO_ROOT> [CONF]   (the dir whose ./data is mounted into the container)
set -u

REPO_ROOT="${1:-}"
if [ -z "$REPO_ROOT" ]; then
  echo "sd-metrics: REPO_ROOT argument required" >&2
  exit 1
fi

CONF="${2:-}"
if [ -z "$CONF" ]; then
  if [ -d /boot/firmware ]; then CONF="/boot/firmware/pieria.conf"; else CONF="/boot/pieria.conf"; fi
fi

OUT_DIR="$REPO_ROOT/data/appliance"
OUT="$OUT_DIR/host_metrics.json"
mkdir -p "$OUT_DIR"
# The container is UNPRIVILEGED (uid 1000) and uses this directory as its mailbox to root — the update
# bridge writes request.json/status.json here. We run as ROOT, so whichever of us creates the directory
# first owns it, and root winning means the container gets EACCES and every "Update App" returns a 500.
# Observed on the first flashed unit, 2026-07-21. Always hand ownership back.
chown 1000:1000 "$OUT_DIR" 2>/dev/null || true

THROTTLED=""
TEMP=""
if command -v vcgencmd >/dev/null 2>&1; then
  # vcgencmd get_throttled -> "throttled=0x0"; measure_temp -> "temp=41.2'C"
  THROTTLED="$(vcgencmd get_throttled 2>/dev/null | cut -d= -f2)"
  TEMP="$(vcgencmd measure_temp 2>/dev/null | cut -d= -f2 | tr -d "'C")"
fi

# Write atomically so a concurrent reader never sees a half-written file.
TMP="$(mktemp "$OUT_DIR/.host_metrics.XXXXXX")"
printf '{"throttled": %s, "temp_c": %s}\n' \
  "$( [ -n "$THROTTLED" ] && printf '"%s"' "$THROTTLED" || printf 'null' )" \
  "$( [ -n "$TEMP" ] && printf '%s' "$TEMP" || printf 'null' )" \
  > "$TMP"
mv -f "$TMP" "$OUT"
# mktemp makes the file 0600; the non-root (uid 1000) container reads it via host_health, so make it
# world-readable (root writes it, the container only reads).
chmod 0644 "$OUT" 2>/dev/null || true

# --- conf mirror for the container (ADR-119) -------------------------------------------------------
# Re-export only when the mirror is missing or the conf is NEWER, so the 30s timer costs nothing in
# the steady state but self-heals a hand-edited card on the next tick.
CONF_JSON="$OUT_DIR/conf.json"
SD_CONF_BIN="${SD_CONF_BIN:-$(dirname "$(readlink -f "$0")")/sd-conf}"
[ -x "$SD_CONF_BIN" ] || SD_CONF_BIN="/usr/local/bin/sd-conf"
if [ -x "$SD_CONF_BIN" ] && [ -r "$CONF" ]; then
  if [ ! -f "$CONF_JSON" ] || [ "$CONF" -nt "$CONF_JSON" ]; then
    "$SD_CONF_BIN" --conf "$CONF" export --out "$CONF_JSON" 2>/dev/null || true
  fi
fi
