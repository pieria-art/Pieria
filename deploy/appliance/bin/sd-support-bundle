#!/usr/bin/env bash
# sd-support-bundle — one downloadable tarball of everything you'd ask for over SSH (ADR-119).
#
# A shipped appliance has no shell: sshd is disabled and every password is locked (ADR-064). So when
# a display misbehaves in a stranger's house, "send me the output of journalctl" is not a thing that
# can happen. This collects it instead, into data/appliance/support-bundle.tar.gz, which the admin UI
# offers as a download.
#
# Every item is BEST-EFFORT: a missing vcgencmd, no docker, no previous boot in the journal — each
# just yields a short file saying so. A bundle that fails because one probe is unavailable is a
# bundle nobody ever gets.
#
# NOTHING SECRET MAY RIDE THIS FILE. The user will mail it to us, paste it in an issue, or drop it in
# a forum thread. So: the conf is redacted (redact_conf, below), .env contributes NAMES ONLY and
# never values, and nmcli is called WITHOUT --show-secrets, which is what would otherwise print every
# saved Wi-Fi PSK in plain text.
#
# Usage: sd-support-bundle <REPO_ROOT>
set -u

#: Redact any conf line whose KEY NAME looks like a credential, keeping the name so a reader can see
#: that it is set. A function, not an inline sed, so the redaction can be unit-tested directly:
#:     bash -c 'SD_SUPPORT_BUNDLE_LIB=1 . sd-support-bundle; redact_conf' < fixture
redact_conf() {
  sed -E 's/^([[:space:]]*[A-Za-z0-9_]*(KEY|TOKEN|PASS|PSK|SECRET)[A-Za-z0-9_]*)[[:space:]]*=.*/\1=<redacted>/'
}

# Sourced as a library (tests) — stop here, with the functions defined and nothing collected.
[ "${SD_SUPPORT_BUNDLE_LIB:-0}" = "1" ] && return 0

REPO_ROOT="${1:-}"
if [ -z "$REPO_ROOT" ]; then
  echo "sd-support-bundle: REPO_ROOT argument required" >&2
  exit 1
fi

OUT_DIR="$REPO_ROOT/data/appliance"
OVERRIDE="$REPO_ROOT/deploy/appliance/compose/docker-compose.appliance.yml"

# L6: the container (uid 1000) can replace data/appliance ITSELF with a symlink (e.g. to /etc) — every
# read/write this script does into it now goes through sd-mailbox, which opens data/ then "appliance"
# with O_NOFOLLOW and refuses closed if that fails, rather than a bare `mkdir -p`/`cp` following it.
SD_MAILBOX_BIN="${SD_MAILBOX_BIN:-$(dirname "$(readlink -f "$0")")/sd-mailbox}"
mbox() { "$SD_MAILBOX_BIN" --repo-root "$REPO_ROOT" "$@"; }

if [ -n "${SD_CONF:-}" ]; then
  CONF="$SD_CONF"
elif [ -d /boot/firmware ]; then
  CONF="/boot/firmware/pieria.conf"
else
  CONF="/boot/pieria.conf"
fi

WORK="$(mktemp -d)"
STAGE="$WORK/pieria-support"
mkdir -p "$STAGE/appliance"
trap 'rm -rf "$WORK"' EXIT

# Every collector runs inside this: a failure becomes a note in the file, never a failed bundle.
grab() {
  local dest="$1"; shift
  if ! "$@" > "$STAGE/$dest" 2>&1; then
    printf '\n[sd-support-bundle: `%s` failed or is unavailable on this box]\n' "$*" >> "$STAGE/$dest"
  fi
}

# --- logs ------------------------------------------------------------------------------------------
grab journal-current.txt   journalctl -b -n 3000 -o short-iso --no-pager
grab journal-kernel.txt    journalctl -b -k -n 1000 -o short-iso --no-pager
# The PREVIOUS boot is where a crash-and-reboot actually lives; install.sh makes the journal
# persistent for exactly this reason (ADR-056).
grab journal-previous.txt  journalctl -b -1 -n 2000 -o short-iso --no-pager
grab journal-sd-units.txt  journalctl -u 'sd-*' -n 2000 -o short-iso --no-pager
grab units.txt             systemctl list-units --all --no-pager --no-legend

# --- this box --------------------------------------------------------------------------------------
{
  echo "=== uname ==="; uname -a 2>&1
  echo; echo "=== os-release ==="; cat /etc/os-release 2>&1
  echo; echo "=== uptime ==="; uptime 2>&1
  echo; echo "=== free ==="; free -h 2>&1
  echo; echo "=== df ==="; df -h 2>&1
  echo; echo "=== timedatectl ==="; timedatectl 2>&1
  echo; echo "=== throttled / temp / firmware (Pi only) ==="
  if command -v vcgencmd >/dev/null 2>&1; then
    vcgencmd get_throttled 2>&1; vcgencmd measure_temp 2>&1; vcgencmd version 2>&1
  else
    echo "(no vcgencmd — not a Raspberry Pi, or running off-device)"
  fi
  echo; echo "=== rpi-eeprom ==="
  command -v rpi-eeprom-update >/dev/null 2>&1 && rpi-eeprom-update 2>&1 || echo "(not available)"
} > "$STAGE/system.txt" 2>&1

# The kiosk stack's versions — the first question after any "the picture froze" report (ADR-118 was
# Chromium 149, pinned by neglect).
{
  for c in chromium chromium-browser cage wlr-randr docker; do
    printf '=== %s ===\n' "$c"
    command -v "$c" >/dev/null 2>&1 && "$c" --version 2>&1 || echo "(not installed)"
    echo
  done
  echo "=== dpkg ==="
  dpkg -l chromium chromium-browser cage wlr-randr seatd 2>&1 | tail -n +1
} > "$STAGE/versions.txt" 2>&1

# Top consumers by memory then CPU — a wedged renderer shows up here as a flat pinned core.
{
  echo "=== top RSS ==="
  ps -eo pid,ppid,rss,pcpu,etime,comm --sort=-rss 2>&1 | head -25
  echo; echo "=== top CPU ==="
  ps -eo pid,ppid,rss,pcpu,etime,comm --sort=-pcpu 2>&1 | head -25
} > "$STAGE/processes.txt" 2>&1

# NEVER --show-secrets: that prints every saved Wi-Fi PSK in plain text.
{
  echo "=== ip -br addr ==="; ip -br addr 2>&1
  echo; echo "=== routes ==="; ip route 2>&1
  echo; echo "=== nmcli device status ==="
  command -v nmcli >/dev/null 2>&1 && nmcli -t device status 2>&1 || echo "(no nmcli)"
  echo; echo "=== saved connections (names only) ==="
  command -v nmcli >/dev/null 2>&1 && nmcli -t -f NAME,TYPE connection show 2>&1 || echo "(no nmcli)"
} > "$STAGE/network.txt" 2>&1

# --- the app ----------------------------------------------------------------------------------------
{
  echo "=== docker ps ==="
  docker ps -a 2>&1 || echo "(no docker)"
  echo; echo "=== images ==="
  docker images 2>&1 || true
} > "$STAGE/docker-ps.txt" 2>&1
( cd "$REPO_ROOT" && docker compose -f docker-compose.yml -f "$OVERRIDE" logs --tail 200 ) \
  > "$STAGE/container.log" 2>&1 || echo "(could not read container logs)" >> "$STAGE/container.log"

# --- configuration, redacted -------------------------------------------------------------------------
if [ -r "$CONF" ]; then
  redact_conf < "$CONF" > "$STAGE/pieria.conf.redacted" 2>/dev/null
else
  echo "(no conf at $CONF)" > "$STAGE/pieria.conf.redacted"
fi
# NAMES only. The whole point of .env is that it holds the Gemini key.
if [ -r "$REPO_ROOT/.env" ]; then
  sed -E 's/=.*//' "$REPO_ROOT/.env" | grep -E '^[A-Za-z_]' > "$STAGE/env.keys" 2>/dev/null || true
fi
[ -f "$STAGE/env.keys" ] || echo "(no .env)" > "$STAGE/env.keys"

# --- the bridge's own state ---------------------------------------------------------------------------
# L6: these live in data/appliance/, writable by the unprivileged container (which can even replace the
# DIRECTORY itself with a symlink) — read each one through sd-mailbox rather than `cp` by path, so a
# planted symlink (file- or directory-level) is refused rather than followed, which would otherwise let
# a container-side attacker point us at an arbitrary file and have its contents (read as root) land in
# a bundle the user may paste into a public issue.
for f in watchdog.json host_metrics.json update-check.json os-updates.json status.json conf.json \
         last-update.log watchdog-reboots.log; do
  mbox read "$f" > "$STAGE/appliance/$f" 2>/dev/null || rm -f "$STAGE/appliance/$f"
done

# --- pack it ------------------------------------------------------------------------------------------
date -u +"collected %Y-%m-%dT%H:%M:%SZ on $(hostname 2>/dev/null || echo unknown)" > "$STAGE/README.txt"
TMP_TGZ="$WORK/bundle.tar.gz"
( cd "$WORK" && tar czf "$TMP_TGZ" pieria-support ) || { echo "sd-support-bundle: tar failed" >&2; exit 1; }
# TMP_TGZ lives under WORK ($(mktemp -d), root-private, outside data/) so chown/chmod BY PATH on it
# here is safe — the container can never touch this directory or replant anything at this path.
chown 1000:1000 "$TMP_TGZ" 2>/dev/null || true
chmod 0644 "$TMP_TGZ" 2>/dev/null || true
# L6: the FINAL publish, however, is into data/appliance/ (container-writable, uid 1000, and
# replaceable wholesale with a symlink) — so it goes through sd-mailbox's copy-in, which opens data/
# then "appliance" with O_NOFOLLOW, copies the already-owned/moded tarball's bytes into a fresh temp
# file IN THE VERIFIED DEST DIR, sets owner/mode again on that open fd (never by path), and
# os.replace()s it over the target — which replaces whatever directory entry is there (symlink
# included) rather than writing through it. Atomic: the UI may be polling for this file, and a
# half-written tarball downloads as a corrupt one.
mbox copy-in "$TMP_TGZ" support-bundle.tar.gz --mode 0644 --owner 1000:1000
echo "sd-support-bundle: wrote $OUT_DIR/support-bundle.tar.gz ($(du -h "$TMP_TGZ" 2>/dev/null | cut -f1))"
