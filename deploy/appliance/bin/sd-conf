#!/usr/bin/env python3
"""sd-conf — the ONE reader/validator/writer for the appliance `pieria.conf` (ADR-119).

The conf is `.`-sourced as shell by four scripts (sd-kiosk-launch, sd-watchdog, sd-quiet-hours,
install.sh). That makes every value a potential command: a value of `x; rm -rf /` is not a bad
setting, it is code. So `SAFE_VALUE_RE` — not the per-key validators — is the load-bearing control,
and it is enforced at BOTH gates (the container's endpoint and this script, run as root on the host).
The web app never writes the conf itself; it asks, via the update bridge, and this is what runs.

Importable (the app loads it with SourceFileLoader — `deploy/` IS in the container image, see
.dockerignore) and a CLI:

    sd-conf [--conf PATH] set KEY=VALUE [KEY=VALUE ...]   # validate ALL, then write atomically
    sd-conf [--conf PATH] get KEY
    sd-conf [--conf PATH] validate KEY VALUE              # exit 0 = ok, 2 = rejected
    sd-conf [--conf PATH] export [--out PATH]             # non-secret mirror -> conf.json

Writing preserves comments, ordering, and every key it was not asked to change (ADR-059 #1) — a
wizard re-run once deleted EINK_*/WATCHDOG by rendering a fixed key set, and that must not recur.
"""
from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
import tempfile
from datetime import UTC, datetime
from pathlib import Path

# --- the injection control ------------------------------------------------------------------------
#: Every conf value must match this. Deliberately tiny: no spaces, no quotes, no `$`, no backticks,
#: no `;`, no newlines — nothing that survives `.`-sourcing as anything but a literal.
SAFE_VALUE_RE = re.compile(r"^[A-Za-z0-9_./:+@,-]*$")

#: orientation choice -> ROTATE value. MIRRORS sd_setup.ORIENTATIONS (a test pins the pairing).
ORIENTATIONS = {"landscape": "", "90": "90", "180": "180", "270": "270"}

_DISPLAY_ID_RE = re.compile(r"[^a-z0-9_-]+")
_SERVER_URL_RE = re.compile(r"^https?://[^\s/]+(?::\d+)?(?:/.*)?$")
_TIMEZONE_RE = re.compile(r"^[A-Za-z][A-Za-z0-9_+\-]*(/[A-Za-z0-9_+\-]+){0,2}$")
_HHMM_RE = re.compile(r"^([01][0-9]|2[0-3]):[0-5][0-9]$")
#: Anything whose NAME looks like a credential never leaves this file, whatever the whitelist says.
_SECRET_NAME_RE = re.compile(r"KEY|TOKEN|PASS|PSK|SECRET")


def sanitize_display_id(raw: str) -> str:
    """Byte-identical to sd_setup.sanitize_display_id (a test pins the equality).

    Two copies exist because the wizard is stdlib-only and standalone on the boot path while this runs
    both in the container and on the host; a drift between them would silently rename a display."""
    return _DISPLAY_ID_RE.sub("_", (raw or "").strip().lower()).strip("_-")


def valid_timezone(tz: str) -> bool:
    """True for a zone name this box can set. Copied from sd_setup.valid_timezone: shape check, plus
    membership in the OS zoneinfo when there IS one. In the container that means the `tzdata` pip
    package (python:3.11-slim ships no zone data) — without it the shape check stands alone."""
    tz = (tz or "").strip()
    if not tz or len(tz) > 64 or not _TIMEZONE_RE.match(tz):
        return False
    try:
        from zoneinfo import available_timezones
        zones = available_timezones()
    except Exception:  # noqa: BLE001 — no tzdata -> shape check only
        return True
    return tz in zones if zones else True


# --- per-key validators ----------------------------------------------------------------------------
# Each returns an error message, or None when the value is acceptable. SAFE_VALUE_RE is applied to
# every key on top of these, so a validator only has to express the key's OWN meaning.

def _v_timezone(v):
    return None if valid_timezone(v) else "Use a zone name like America/Chicago or Europe/London."


def _v_rotate(v):
    return None if v in ("", "90", "180", "270") else "Orientation must be landscape, 90, 180 or 270."


def _v_eink_orientation(v):
    return None if v in ("", "portrait") else "EINK_ORIENTATION must be blank or 'portrait'."


def _v_display_id(v):
    if not v:
        return "Give this display a name (letters, numbers, - or _)."
    if v != sanitize_display_id(v):
        return "Display name must be lowercase letters, numbers, - or _."
    return None


def _v_watchdog(v):
    return None if v in ("observe", "enforce", "off") else "Self-heal must be observe, enforce or off."


def _v_schedule(v):
    return None if v in ("off", "weekly") else "Schedule must be off or weekly."


def _v_time(v):
    return None if _HHMM_RE.match(v or "") else "Time must be HH:MM (24-hour)."


def _v_server_url(v):
    return None if _SERVER_URL_RE.match(v or "") else "Must look like http://host:port."


VALIDATORS = {
    "TIMEZONE": _v_timezone,
    "ROTATE": _v_rotate,
    "EINK_ORIENTATION": _v_eink_orientation,
    "DISPLAY_ID": _v_display_id,
    "WATCHDOG": _v_watchdog,
    "OS_UPDATE_SCHEDULE": _v_schedule,
    "OS_UPDATE_TIME": _v_time,
    "SERVER_URL": _v_server_url,
}

#: Keys sd-conf is willing to write at all. A key absent here is refused outright rather than
#: waved through by SAFE_VALUE_RE — the bridge must never become a general-purpose conf editor.
WRITABLE_KEYS = set(VALIDATORS)

#: Keys mirrored into data/appliance/conf.json for the container to read. Whitelist, not blacklist.
EXPORT_KEYS = (
    "SERVER_URL", "DISPLAY_ID", "HOSTNAME", "TIMEZONE", "MODE", "CYCLE_TIME", "ROTATE", "OUTPUT",
    "WAIT_TIMEOUT", "ALL_IN_ONE", "WATCHDOG", "EINK_ENABLED", "EINK_ORIENTATION",
    "EINK_MIN_INTERVAL", "EINK_SATURATION", "OS_UPDATE_SCHEDULE", "OS_UPDATE_TIME",
)


def validate(key: str, value: str) -> str | None:
    """The single gate. Returns an error message, or None when `value` may be written to `key`."""
    key = (key or "").strip()
    value = "" if value is None else str(value).strip()
    if key not in WRITABLE_KEYS:
        return f"unknown setting: {key}"
    if not SAFE_VALUE_RE.match(value):
        return "Value contains characters that aren't allowed here."
    if len(value) > 64:
        return "Value is too long."
    return VALIDATORS[key](value)


# --- conf text surgery ------------------------------------------------------------------------------

def _line_key(raw: str):
    """The KEY of an assignment line, or None for a comment / blank / non-assignment."""
    line = raw.strip()
    if not line or line.startswith("#") or "=" not in line:
        return None
    return line.split("=", 1)[0].strip() or None


def get_key(text: str, key: str):
    """The FIRST assignment of `key`, or None. set_keys rewrites that same first line, so the two
    agree; a later duplicate is dropped on write precisely because it would win under `.`-sourcing."""
    for raw in (text or "").splitlines():
        if _line_key(raw) == key:
            return raw.strip().split("=", 1)[1].strip()
    return None


def set_keys(text: str, updates: dict) -> str:
    """Return `text` with `updates` applied IN PLACE — ADR-059 #1.

    Replaces the first `KEY=` line for each key, drops any LATER duplicate of a key being set (a
    duplicate would win under `.`-sourcing and silently undo the edit), appends keys that were absent,
    and leaves comments, blank lines, ordering and every other key byte-identical."""
    out, seen = [], set()
    for raw in (text or "").splitlines():
        key = _line_key(raw)
        if key is None or key not in updates:
            out.append(raw)
            continue
        if key in seen:
            continue
        seen.add(key)
        out.append(f"{key}={updates[key]}")
    for key, value in updates.items():
        if key not in seen:
            out.append(f"{key}={value}")
    return ("\n".join(out) + "\n") if out else ""


def export_view(text: str) -> dict:
    """The non-secret mirror of the conf. Whitelisted keys only, and never a key whose NAME looks
    like a credential — GEMINI_API_KEY sits in this file and must not reach the browser."""
    values = {}
    for key in EXPORT_KEYS:
        if _SECRET_NAME_RE.search(key):
            continue
        v = get_key(text, key)
        if v is not None:
            values[key] = v
    return values


# --- paths + IO ---------------------------------------------------------------------------------

def resolve_conf_path() -> Path:
    """Where the conf lives. SD_CONF wins (tests, odd layouts); else the Bookworm rule that
    sd_setup.resolve_boot_conf_path uses — /boot/firmware if that dir exists, else /boot."""
    env = os.environ.get("SD_CONF", "").strip()
    if env:
        return Path(env)
    # is_dir() can RAISE, not just answer False: on a hardened dev box /boot/firmware exists but is
    # mode 0700 root, and the PermissionError propagated out of a `validate` call that never needed a
    # path at all. Resolving a default must never be the thing that fails.
    try:
        firmware = Path("/boot/firmware").is_dir()
    except OSError:
        firmware = False
    return Path("/boot/firmware" if firmware else "/boot") / "pieria.conf"


def read_conf(path) -> str:
    try:
        return Path(path).read_text()
    except OSError:
        return ""


def _handback(path) -> None:
    """Root wrote it; the unprivileged container (uid 1000) reads it. ADR-037: hand ownership back
    and make it world-readable, or the next GUI read is an EACCES nobody can explain. Best-effort —
    on the FAT boot partition ownership is a no-op, and as a non-root caller chown simply fails."""
    try:
        os.chown(path, 1000, 1000)
    except (OSError, AttributeError):
        pass
    try:
        os.chmod(path, 0o644)
    except OSError:
        pass


def write_atomic(path, text: str, handback: bool = True) -> None:
    """Write via a temp file in the same directory + os.replace, so a concurrent reader (the kiosk
    launcher sourcing the conf at boot) never sees a half-written file."""
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=str(path.parent), prefix=".sd-conf.")
    try:
        with os.fdopen(fd, "w") as fh:
            fh.write(text)
        if handback:
            _handback(tmp)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def _host_timezone() -> str:
    try:
        out = subprocess.run(["timedatectl", "show", "-p", "Timezone", "--value"],
                             capture_output=True, text=True, timeout=5)
        if out.returncode == 0 and out.stdout.strip():
            return out.stdout.strip()
    except (OSError, subprocess.SubprocessError):
        pass
    try:
        return Path("/etc/timezone").read_text().strip()
    except OSError:
        return ""


def _timer_state(unit: str = "sd-os-upgrade.timer") -> dict:
    """Is the weekly upgrade timer armed, and when does it next fire? Best-effort: a dev box has no
    systemd and must report 'not enabled' rather than raise."""
    state = {"enabled": False, "next": ""}
    try:
        out = subprocess.run(["systemctl", "is-enabled", unit], capture_output=True, text=True, timeout=5)
        state["enabled"] = out.stdout.strip() in ("enabled", "enabled-runtime")
    except (OSError, subprocess.SubprocessError):
        return state
    try:
        out = subprocess.run(["systemctl", "show", "-p", "NextElapseUSecRealtime", "--value", unit],
                             capture_output=True, text=True, timeout=5)
        val = out.stdout.strip()
        if val and val not in ("0", "n/a"):
            state["next"] = val
    except (OSError, subprocess.SubprocessError):
        pass
    return state


def build_export(conf_path) -> dict:
    text = read_conf(conf_path)
    return {
        "exported_at": datetime.now(UTC).strftime("%Y-%m-%dT%H:%M:%SZ"),
        "conf_path": str(conf_path),
        "values": export_view(text),
        "host_timezone": _host_timezone(),
        "os_upgrade_timer": _timer_state(),
    }


# --- CLI -------------------------------------------------------------------------------------------

def main(argv=None) -> int:
    ap = argparse.ArgumentParser(description="Read/validate/write the appliance pieria.conf")
    ap.add_argument("--conf", default="", help="conf path (default: $SD_CONF or the boot partition)")
    sub = ap.add_subparsers(dest="cmd", required=True)
    p_set = sub.add_parser("set")
    p_set.add_argument("pairs", nargs="+", metavar="KEY=VALUE")
    p_get = sub.add_parser("get")
    p_get.add_argument("key")
    p_val = sub.add_parser("validate")
    p_val.add_argument("key")
    p_val.add_argument("value", nargs="?", default="")
    p_exp = sub.add_parser("export")
    p_exp.add_argument("--out", default="")
    args = ap.parse_args(argv)

    # `validate` is a pure question about a value — never resolve a conf path for it.
    if args.cmd == "validate":
        err = validate(args.key, args.value)
        if err:
            print(err, file=sys.stderr)
            return 2
        return 0

    conf_path = Path(args.conf) if args.conf else resolve_conf_path()

    if args.cmd == "get":
        print(get_key(read_conf(conf_path), args.key) or "")
        return 0

    if args.cmd == "export":
        out = Path(args.out) if args.out else (conf_path.parent / "conf.json")
        write_atomic(out, json.dumps(build_export(conf_path), indent=2) + "\n")
        return 0

    # set — validate EVERY pair before writing ANY of them, so a bad second key can never leave the
    # conf half-applied (orientation writes two keys at once; one without the other is a wrong screen).
    updates = {}
    for pair in args.pairs:
        if "=" not in pair:
            print(f"sd-conf: expected KEY=VALUE, got {pair!r}", file=sys.stderr)
            return 2
        key, _, value = pair.partition("=")
        key, value = key.strip(), value.strip()
        err = validate(key, value)
        if err:
            print(f"sd-conf: {key}: {err}", file=sys.stderr)
            return 2
        updates[key] = value
    write_atomic(conf_path, set_keys(read_conf(conf_path), updates))
    return 0


if __name__ == "__main__":
    sys.exit(main())
