#!/usr/bin/env bash
# sd-wait-for-server URL [TIMEOUT_SECONDS]
#
# Block until the Pieria server answers an HTTP request, so the kiosk
# browser never lands on a "can't connect" error page during a cold boot
# (e.g. the LAN/server isn't up yet). TIMEOUT_SECONDS=0 (default) waits forever.
set -u

URL="${1:?usage: sd-wait-for-server URL [TIMEOUT_SECONDS]}"
TIMEOUT="${2:-0}"

start=$(date +%s)
attempt=0
while true; do
  if curl --silent --fail --max-time 5 --output /dev/null "$URL"; then
    exit 0
  fi
  attempt=$((attempt + 1))
  if [ "$TIMEOUT" -ne 0 ]; then
    now=$(date +%s)
    if [ $((now - start)) -ge "$TIMEOUT" ]; then
      echo "sd-wait-for-server: timed out after ${TIMEOUT}s waiting for $URL" >&2
      exit 1
    fi
  fi
  # Log occasionally so `journalctl` shows progress without flooding.
  if [ $((attempt % 15)) -eq 1 ]; then
    echo "sd-wait-for-server: waiting for $URL ..." >&2
  fi
  sleep 2
done
