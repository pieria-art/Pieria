#!/usr/bin/env bash
# sd-watchdog — kiosk / server self-heal (R1-F3). Reliability as a documented feature: an appliance
# behind a wall-mounted TV must survive months unattended without a power cycle.
#
# Probes the server (HTTP), the kiosk (cage + Chromium alive), and — via sd-watchdog-advance — whether
# the Canvas PAGE is alive (page-owned heartbeat) and its picture still changing. On SUSTAINED failure (hysteresis:
# FAIL_THRESHOLD consecutive bad probes, so a transient blip is ignored) it escalates —
#
# ADR-121 (2026-09-20): a browser-level fault (server reachable, kiosk/paint/live/advance unhealthy)
# escalates ONLY as far as relaunch-kiosk, then gives up and just observes. Only the server being
# genuinely unreachable can reach restart-container / reboot — a reboot never fixed a wedged page, and
# the previous escalation-by-fail-count-alone rebooted through an in-flight app update six times in
# 50 minutes on the bench:
#     fails 1-2  no action (hysteresis)
#     fails 3-5  browser fault -> relaunch-kiosk   |  e-ink fault -> restart-eink |  server down -> restart-container
#     fails 6+   browser fault -> give up, observe |  e-ink fault -> give up      |  server down -> reboot
# with a reboot cap (3 per 6h) and a 10-minute post-boot grace so a genuinely-broken box can't
# boot-loop, or compound a crash-on-boot into something tighter than the timer's own 60s cadence. The
# watchdog also PAUSES ENTIRELY — no probe, no action, fail counter untouched — while an Admin ->
# Devices appliance action (sd-update's own status.json) is queued/running and under 30 minutes old.
#
# F6 (2026-09-22): a dead sd-eink (has_eink=1, server up, no kiosk) used to pick no action forever and
# log nothing — a dead e-ink client looked identical to a healthy frame on the wall. restart-eink mirrors
# relaunch-kiosk's ladder and gives up (never reboots) past ESCALATE_AFTER, same as the browser-fault
# path — but e-ink gets its OWN fail counter (fails_eink / STATE_EINK), separate from the kiosk-side
# fails_display, so a kiosk episode can never burn e-ink's restart attempts (or vice versa) and a dual
# box (both surfaces present) can act on BOTH rungs independently when both are faulted, instead of one
# masking the other behind an elif. The bench procedure deliberately `disable`s sd-eink while pushing to
# the panel manually (it holds the SPI/GPIO lines) — if EINK_HOLD_FLAG exists (default
# /run/pieria-eink-hold, override via SD_EINK_HOLD_FLAG) the watchdog reports the held state but never
# touches sd-eink. That check runs BEFORE the give-up check: a held bench session must always report
# "eink-held", never "gave up", no matter how long fails_eink has been climbing while held.
#
# MODE (pieria.conf  WATCHDOG=):
#   observe  (default) — probe + log what it WOULD do, take NO action. Safe to run un-verified.
#   enforce            — actually relaunch / restart / reboot.
#   off                — no-op.
#
# Writes data/appliance/watchdog.json for the Devices console ("last self-heal"). Run by a systemd timer.
#
# ⚠ Pi-gated: the enforce actions (session relaunch / docker restart / reboot) are only fully validated
# on real hardware — verify on the bench Pi before flipping WATCHDOG=enforce on a production display.
set -u

CONF="${1:-/boot/firmware/pieria.conf}"
[ -e "$CONF" ] || CONF="/boot/pieria.conf"
REPO_ROOT="${2:-$HOME/Pieria}"

# shellcheck disable=SC1090
[ -r "$CONF" ] && . "$CONF" 2>/dev/null || true
SERVER_URL="${SERVER_URL:-http://localhost:8000}"
MODE="${WATCHDOG:-observe}"
[ "$MODE" = "off" ] && exit 0

# data/appliance is the container's mailbox to root.
# The container is UNPRIVILEGED (uid 1000) and uses this directory as its mailbox to root — the update
# bridge writes request.json/status.json here. We run as ROOT, so whichever of us creates the directory
# first owns it, and root winning means the container gets EACCES and every "Update App" returns a 500.
# Observed on the first flashed unit, 2026-07-21. Always hand ownership back.
#
# L6: the container can also replace data/appliance ITSELF with a symlink (e.g. to /etc) — a bare
# `mkdir -p`/`chown` by path would create the dir (harmless) or follow the symlink and chown whatever
# it points to, as root. Every read/write/chown into this directory now goes through sd-mailbox, which
# opens data/ then "appliance" with O_NOFOLLOW and refuses closed if that fails.
SD_MAILBOX_BIN="${SD_MAILBOX_BIN:-$(dirname "$(readlink -f "$0")")/sd-mailbox}"
mbox() { "$SD_MAILBOX_BIN" --repo-root "$REPO_ROOT" "$@"; }
mbox chown-dir 2>/dev/null || true
STATUS="watchdog.json"
# L6: writes to $STATUS used to `mktemp` IN data/appliance/ (container-writable, uid 1000) and then
# `chmod` BY PATH before the mv-over — a container-side attacker can unlink that temp entry and
# replant a symlink at the same path between the mktemp and the chmod; chmod follows symlinks, so that
# window would let root chmod an arbitrary file outside data/appliance/. sd-mailbox's `write` sets the
# mode on the OPEN FD instead (never by path), then atomically replaces the target — same pattern as
# sd-update's write_status. Best-effort: on any failure this logs nothing louder than a skipped write;
# it must never abort a watchdog tick.
write_status_atomic() {
  printf '%s' "$1" | mbox write "$STATUS" --mode 0644 2>/dev/null || true
}
# Consecutive-failure counter. Lives in /run ON PURPOSE: it must reset on reboot, so a box that
# escalated to a reboot comes back with a clean count instead of immediately re-escalating (boot-loop
# guard). Overridable for testing in an environment without a writable /run.
STATE="${SD_WATCHDOG_STATE:-/run/sd-watchdog.fails}"
# A SECOND, independent consecutive-fail counter for display-side faults (kiosk and/or e-ink), so a
# display fault can never inflate the count that decides restart-container/reboot, and a server blip
# can never inflate the count that decides relaunch-kiosk/give-up. Before this split, a single shared
# counter meant an e-ink box with the server up and sd-eink down (sd-eink is deliberately `disabled`
# during a bench panel session — it holds the SPI/GPIO lines) pinned `fails` above ESCALATE_AFTER with
# no remedy, so the NEXT unrelated server blip jumped straight to reboot — the exact ADR-121 regression.
STATE_DISPLAY="${SD_WATCHDOG_STATE_DISPLAY:-/run/sd-watchdog.display-fails}"
# F6: e-ink's OWN counter, independent of STATE_DISPLAY (kiosk-only as of this fix) — see the F6
# comment above for why a shared counter was a bug (a kiosk fault could burn e-ink's restart budget
# and mask an independent e-ink fault on a dual box, and vice versa).
STATE_EINK="${SD_WATCHDOG_STATE_EINK:-/run/sd-watchdog.eink-fails}"
COMPOSE=(-f docker-compose.yml -f deploy/appliance/compose/docker-compose.appliance.yml)

FAIL_THRESHOLD=3        # consecutive bad probes before acting (hysteresis)
# ADR-121: the SAME fails count that promotes a server-down box to reboot is, for a browser-level
# fault (server reachable, kiosk/paint/live/advance unhealthy), the point where we STOP acting instead
# — a reboot never fixed a wedged page (that's the whole 2026-09-20 incident: 6 reboots in 50 minutes,
# each one killing an in-flight apt upgrade). "3 consecutive relaunch-kiosk actions without recovery"
# is fails 3,4,5; fails reaching this second threshold (6) means those 3 relaunches didn't help.
ESCALATE_AFTER=$((FAIL_THRESHOLD * 2))
REBOOT_CAP=3            # at most this many reboots ...
REBOOT_WINDOW=$((6 * 3600))   # ... within this many seconds (boot-loop guard) — was 1800s (30 min),
                               # which only slowed the 2026-09-20 loop rather than stopping it.
MIN_UPTIME_FOR_REBOOT=600     # never reboot within this many seconds of boot (avoid compounding a
                               # crash-on-boot into a tighter loop than the timer's own 60s cadence).
UPTIME_FILE="${SD_UPTIME_FILE:-/proc/uptime}"   # overridable so a test can fake "just booted"
# F6: bench panel sessions `disable` sd-eink to hold the SPI/GPIO lines for manual pushes — the
# watchdog must never fight that. Presence alone suppresses restart-eink (content unchecked).
EINK_HOLD_FLAG="${SD_EINK_HOLD_FLAG:-/run/pieria-eink-hold}"

now="$(date +%s)"
now_iso="$(date -Is 2>/dev/null || date)"

# --- enforce actions (only called when MODE=enforce) --------------------------
reboot_capped() {
  local uptime_s
  uptime_s="$(awk '{print int($1)}' "$UPTIME_FILE" 2>/dev/null)"
  case "$uptime_s" in ''|*[!0-9]*) uptime_s=999999 ;; esac
  if [ "$uptime_s" -lt "$MIN_UPTIME_FOR_REBOOT" ]; then
    logger -t sd-watchdog "within ${MIN_UPTIME_FOR_REBOOT}s of boot (uptime ${uptime_s}s) — refusing to reboot"
    return 0
  fi
  # Boot-loop guard: refuse to reboot if we've already rebooted REBOOT_CAP times in REBOOT_WINDOW.
  # L6: REBOOTS lives in data/appliance, which the unprivileged container (uid 1000) can write into —
  # both the read (counting recent reboots) and the append go through sd-mailbox, which opens the
  # (verified, non-symlink) directory once and then this name with O_NOFOLLOW, so even a
  # TOCTOU-planted symlink can't redirect either operation (as root) to an arbitrary file.
  local recent=0
  recent="$(mbox read watchdog-reboots.log 2>/dev/null | awk -v n="$now" -v w="$REBOOT_WINDOW" '$1 > n - w' | wc -l)"
  if [ "$recent" -ge "$REBOOT_CAP" ]; then
    logger -t sd-watchdog "reboot cap reached ($recent in ${REBOOT_WINDOW}s) — refusing to reboot (boot-loop guard)"
    return 0
  fi
  printf '%s\n' "$now" | mbox append watchdog-reboots.log 2>/dev/null \
    || logger -t sd-watchdog "refusing to record reboot: watchdog-reboots.log is a symlink"
  systemctl reboot
}

perform() {
  case "$1" in
    relaunch-kiosk)    systemctl restart getty@tty1 2>/dev/null || pkill -f "[c]hromium" 2>/dev/null || true ;;
    restart-eink)      systemctl reset-failed sd-eink 2>/dev/null; systemctl enable --now sd-eink 2>/dev/null || true ;;
    restart-container) ( cd "$REPO_ROOT" && docker compose "${COMPOSE[@]}" up -d ) 2>/dev/null || true ;;
    reboot)            reboot_capped ;;
  esac
}

# --- pause while an appliance action is in flight (ADR-121) --------------------
# sd-update's own actions (update-app/update-system/restart-app/...) can legitimately leave the
# server unreachable or the kiosk mid-reload for minutes — and update-system's reboot can take the
# whole box down. None of that is a fault the watchdog should act on: the 2026-09-20 incident's
# reboot loop each time killed a running `update-system` apt download outright. If the appliance
# bridge's own status.json says an action is queued/running and recent, pause entirely — no probes,
# no fail-counter change — until it finishes or goes stale (30 min: long enough for a real
# full-upgrade, short enough that a genuinely stuck action doesn't disable self-heal forever).
IN_FLIGHT_MAX_AGE=1800
# L6: status.json is the container's own mailbox file, in the same O_NOFOLLOW-guarded directory as
# everything else here — read it through sd-mailbox rather than opening it by path. Missing/unreadable
# (mbox exits non-zero, empty stdin) falls through the same way a missing file did before: json.load
# raises on empty input, caught below, reported as "not in flight".
# A heredoc can't ALSO consume the piped mbox output — `python3 - <<PY` reads its PROGRAM from stdin,
# which would eat the heredoc and leave nothing for sys.stdin at runtime. Use `-c` instead: the program
# comes from argv, so stdin stays free for the piped JSON.
read -r ia_state ia_age ia_action < <(mbox read status.json 2>/dev/null | python3 -c '
import datetime
import json
import sys

try:
    d = json.load(sys.stdin)
except Exception:
    print("", 999999, "")
    raise SystemExit(0)

state = d.get("state") or ""
action = d.get("action") or "update"
ts = d.get("updated_at") or d.get("queued_at") or ""
age = 999999
if ts:
    try:
        dt = datetime.datetime.fromisoformat(str(ts).replace("Z", "+00:00"))
        if dt.tzinfo is None:
            dt = dt.replace(tzinfo=datetime.timezone.utc)
        age = int((datetime.datetime.now(datetime.timezone.utc) - dt).total_seconds())
    except Exception:
        age = 999999
print(state, age, action)
' 2>/dev/null)
case "$ia_age" in ''|*[!0-9]*) ia_age=999999 ;; esac
case "$ia_state" in
  queued|running)
    if [ "$ia_age" -lt "$IN_FLIGHT_MAX_AGE" ]; then
      write_status_atomic "$(printf '{"mode":"%s","checked_at":"%s","action":"%s","message":"%s"}\n' \
        "$MODE" "$now_iso" "paused: $ia_action in flight" "paused: $ia_action in flight")"
      exit 0
    fi
    ;;
esac

# --- display-surface detection --------------------------------------------------
# A box's display surfaces are TWO INDEPENDENT booleans, not one flag — the bench conf can (and does)
# carry ALL_IN_ONE=1, EINK_ENABLED=1 AND OUTPUT=HDMI-A-1 simultaneously, so "e-ink-only" and "HDMI+e-ink
# dual box" are both real, expressible configurations, and conf flags alone can't tell them apart from
# a plain kiosk box with a stale conf. has_kiosk comes from DRM connector state (any `connected`
# /sys/class/drm/*/status): a box with no connected connector has nothing for cage/chromium to paint
# onto, so kiosk_ok could never be 1 by design if probed — that pinned `fails` above ESCALATE_AFTER
# forever, and the first server blip in WATCHDOG=enforce jumped straight to reboot, skipping
# restart-container. has_eink is simply EINK_ENABLED=1 in the conf. Falls back to has_kiosk=1 (assume
# a kiosk is expected — today's behaviour) if /sys/class/drm doesn't exist at all (dev box / CI).
has_kiosk=1
drm_glob="${SD_DRM_STATUS_GLOB:-/sys/class/drm/*/status}"
saw_any_connector=0
any_connected=0
# shellcheck disable=SC2086 — intentional glob expansion
for f in $drm_glob; do
  [ -e "$f" ] || continue
  saw_any_connector=1
  [ "$(cat "$f" 2>/dev/null)" = "connected" ] && any_connected=1
done
[ "$saw_any_connector" = 1 ] && has_kiosk="$any_connected"
has_eink=0
[ "${EINK_ENABLED:-0}" = "1" ] && has_eink=1

# --- probes -------------------------------------------------------------------
server_ok=0
curl -fsS --max-time 8 -o /dev/null "${SERVER_URL%/}/logo.svg" 2>/dev/null && server_ok=1

# kiosk_ok/paint_ok/live_ok/advance_ok are the HDMI-kiosk surface — forced N/A (1) when has_kiosk=0 so
# they can never hold `healthy` down and never (via display_ok below) drive relaunch-kiosk/give-up on
# a box with no kiosk to relaunch. Untouched when has_kiosk=1 — byte-for-byte the original probes.
kiosk_ok=1
paint_ok=1
live_ok=1
advance_ok=1
if [ "$has_kiosk" = 1 ]; then
  kiosk_ok=0
  # [c] keeps pgrep from matching itself. The compositor AND a browser must be up.
  if pgrep -f "[c]age" >/dev/null 2>&1 && pgrep -f "[c]hromium" >/dev/null 2>&1; then
    kiosk_ok=1
  fi

  # Paint probe: process-alive isn't enough — a Canvas that connected while the server was unhealthy stays
  # WS-connected (so it looks alive) but never starts its image loop (black screen). now-playing exposes
  # exactly that: our display is registered but its artwork is null. If cage+chromium are up but the display
  # isn't actually painting, a kiosk relaunch (browser reload) is the fix — which is what recovers it.
  if [ "$server_ok" = 1 ] && [ "$kiosk_ok" = 1 ]; then
    paint_ok="$(curl -fsS --max-time 8 "${SERVER_URL%/}/api/remote/displays" 2>/dev/null \
      | SD_DID="$DISPLAY_ID" python3 -c 'import os,sys,json
try:
    d = json.load(sys.stdin); did = os.environ["SD_DID"]
    print(1 if any(x.get("display_id") == did and x.get("artwork") for x in d) else 0)
except Exception:
    print(1)' 2>/dev/null || echo 1)"
  fi

  # Liveness + advance probes (2026-09-20). "Artwork non-null" was not enough: the prod Pi held ONE frame
  # for a week with cage+chromium alive, the WebSocket open (protocol ping/pong needs no page JS), and
  # now-playing populated — every probe above passed. The page itself now heart-beats over the socket, so
  # `live` on /api/remote/displays means "the page's JS ran in the last 15s"; and now-playing must CHANGE
  # at least every display_time. Both are decided by sd-watchdog-advance (pure logic, unit-tested); a
  # failure of either, sustained, is a dead browser → relaunch-kiosk, the rung already wired below.
  HELPER="${SD_WATCHDOG_HELPER:-$(dirname "$(readlink -f "$0")")/sd-watchdog-advance}"
  if [ "$server_ok" = 1 ] && [ "$kiosk_ok" = 1 ] && [ -n "${DISPLAY_ID:-}" ] && [ -x "$HELPER" ]; then
    read -r live_ok advance_ok < <(python3 "$HELPER" "$SERVER_URL" "$DISPLAY_ID" 2>/dev/null || echo "1 1")
    case "$live_ok"    in 0|1) ;; *) live_ok=1 ;;    esac
    case "$advance_ok" in 0|1) ;; *) advance_ok=1 ;; esac
  fi
fi

# eink_live_ok is the e-ink surface — forced N/A (1) when has_eink=0. When present, reflects whether
# the sd-eink systemd unit is actually running. NOT folded into an "advance" probe: sd-eink's own
# heartbeat file is only rewritten on a "painted" tick, never on "unchanged" or "quiet" (quiet-hours
# can span all night), so there is no fixed interval sd-watchdog can hold it to without re-deriving
# quiet-hours state — not attempted here; treated as not-applicable for e-ink (see advance_ok above,
# which already covers the always-N/A-for-eink case since it's only computed under has_kiosk).
eink_live_ok=1
if [ "$has_eink" = 1 ]; then
  eink_live_ok=0
  systemctl is-active --quiet sd-eink 2>/dev/null && eink_live_ok=1
fi

display_ok=1
[ "$kiosk_ok" = 1 ] && [ "$paint_ok" = 1 ] && [ "$live_ok" = 1 ] && [ "$advance_ok" = 1 ] && [ "$eink_live_ok" = 1 ] || display_ok=0

healthy=0
[ "$server_ok" = 1 ] && [ "$display_ok" = 1 ] && healthy=1

# Split, PER-SURFACE fault flags (F6 gap 1/2): kiosk_fault covers the HDMI/browser surface
# (kiosk/paint/live/advance), eink_fault covers the e-ink surface alone. A dual box can have either,
# both, or neither faulted independently — display_ok above (used only for the `healthy` verdict)
# stays the OR of everything, but escalation must not.
kiosk_fault=0
[ "$has_kiosk" = 1 ] && { [ "$kiosk_ok" = 0 ] || [ "$paint_ok" = 0 ] || [ "$live_ok" = 0 ] || [ "$advance_ok" = 0 ]; } && kiosk_fault=1
eink_fault=0
[ "$has_eink" = 1 ] && [ "$eink_live_ok" = 0 ] && eink_fault=1

# --- hysteresis + escalation --------------------------------------------------
# THREE independent counters, so no fault can inflate another rung's count: fails_server decides
# restart-container/reboot, fails_display (kiosk-only, as of F6) decides relaunch-kiosk/give-up, and
# fails_eink decides restart-eink/give-up. fails_server moves only on server_ok=0 and resets the
# instant server_ok=1. fails_display/fails_eink move only when the server IS reachable but their own
# surface is faulted, and each resets the instant its own surface recovers (or the server goes down —
# a display-side count must not compound a genuine server outage).
fails_server="$(cat "$STATE" 2>/dev/null || echo 0)"
case "$fails_server" in ''|*[!0-9]*) fails_server=0 ;; esac
fails_display="$(cat "$STATE_DISPLAY" 2>/dev/null || echo 0)"
case "$fails_display" in ''|*[!0-9]*) fails_display=0 ;; esac
fails_eink="$(cat "$STATE_EINK" 2>/dev/null || echo 0)"
case "$fails_eink" in ''|*[!0-9]*) fails_eink=0 ;; esac

action="none"
message="healthy"

if [ "$server_ok" = 1 ]; then
  fails_server=0
else
  fails_server=$((fails_server + 1))
fi
if [ "$server_ok" = 1 ] && [ "$kiosk_fault" = 1 ]; then
  fails_display=$((fails_display + 1))
else
  fails_display=0
fi
if [ "$server_ok" = 1 ] && [ "$eink_fault" = 1 ]; then
  fails_eink=$((fails_eink + 1))
else
  fails_eink=0
fi

if [ "$healthy" != 1 ]; then
  # Pick the escalation rung(s). A browser/e-ink-level fault (server reachable, display surface(s)
  # not) NEVER escalates past relaunch-kiosk/restart-eink — restart-container and reboot are reserved
  # for the server being genuinely unreachable, sustained. ADR-121: the prod incident escalated a
  # wedged-page fault straight through to reboot, and a reboot never fixed a paint fault — it only
  # killed whatever else was running (an in-flight apt upgrade, six times in 50 minutes). When the
  # server itself is down, display-side rungs are not considered at all (their counters are already
  # reset above) — that outage gets the server ladder exclusively.
  want_server="none"
  want_kiosk="none"
  want_eink="none"

  if [ "$server_ok" = 0 ]; then
    if [ "$fails_server" -ge "$FAIL_THRESHOLD" ]; then
      if [ "$fails_server" -ge "$ESCALATE_AFTER" ]; then
        want_server="reboot"
      else
        want_server="restart-container"
      fi
    fi
  else
    if [ "$kiosk_fault" = 1 ] && [ "$fails_display" -ge "$FAIL_THRESHOLD" ]; then
      if [ "$fails_display" -ge "$ESCALATE_AFTER" ]; then
        want_kiosk="give-up"
      else
        want_kiosk="relaunch-kiosk"
      fi
    fi
    # F6: e-ink gets its own rung on its own counter — evaluated independently of kiosk_fault above,
    # so a dual box with BOTH surfaces down addresses both. The hold-flag check runs BEFORE give-up:
    # a held bench session must always report "eink-held", never "gave up", regardless of how long
    # fails_eink has been climbing while held.
    if [ "$eink_fault" = 1 ] && [ "$fails_eink" -ge "$FAIL_THRESHOLD" ]; then
      if [ -e "$EINK_HOLD_FLAG" ]; then
        want_eink="eink-held"
      elif [ "$fails_eink" -ge "$ESCALATE_AFTER" ]; then
        want_eink="give-up"
      else
        want_eink="restart-eink"
      fi
    fi
  fi

  action_parts=()
  message_parts=()

  apply_want() {
    # $1=want $2=fails-count-to-report
    case "$1" in
      none) return ;;
      give-up)
        action_parts+=("give-up")
        message_parts+=("gave up — needs attention (fails=$2, server reachable) — a reboot never fixed a display fault")
        ;;
      eink-held)
        action_parts+=("observe:eink-held")
        message_parts+=("sd-eink restart held (fails=$2): $EINK_HOLD_FLAG present — not touching sd-eink")
        ;;
      *)
        if [ "$MODE" = "enforce" ]; then
          action_parts+=("$1")
          message_parts+=("enforcing: $1 (fails=$2)")
          perform "$1"
        else
          action_parts+=("observe:$1")
          message_parts+=("would $1 (fails=$2) — observe mode, no action taken")
        fi
        ;;
    esac
  }

  apply_want "$want_server" "$fails_server"
  apply_want "$want_kiosk" "$fails_display"
  apply_want "$want_eink" "$fails_eink"

  if [ "${#action_parts[@]}" -eq 0 ]; then
    message="unhealthy (server_ok=$server_ok kiosk_ok=$kiosk_ok paint_ok=$paint_ok live_ok=$live_ok advance_ok=$advance_ok eink_live_ok=$eink_live_ok fails_server=$fails_server fails_display=$fails_display fails_eink=$fails_eink) — within hysteresis"
  else
    action="$(IFS='+'; echo "${action_parts[*]}")"
    # IFS='; ' as a join separator only ever uses IFS's FIRST character ('$*' expansion), so this
    # silently joined with ';' alone — join explicitly with "; ".
    message=""
    for _mp in "${message_parts[@]}"; do
      if [ -z "$message" ]; then message="$_mp"; else message="$message; $_mp"; fi
    done
  fi
fi

printf '%s' "$fails_server" > "$STATE" 2>/dev/null || true
printf '%s' "$fails_display" > "$STATE_DISPLAY" 2>/dev/null || true
printf '%s' "$fails_eink" > "$STATE_EINK" 2>/dev/null || true

# --- status file for the Devices console --------------------------------------
if [ "$has_kiosk" = 1 ] && [ "$has_eink" = 1 ]; then
  display_kind="both"
elif [ "$has_kiosk" = 1 ]; then
  display_kind="kiosk"
elif [ "$has_eink" = 1 ]; then
  display_kind="eink"
else
  display_kind="none"
fi
write_status_atomic "$(printf '{"mode":"%s","checked_at":"%s","display":"%s","server_ok":%s,"kiosk_ok":%s,"paint_ok":%s,"live_ok":%s,"advance_ok":%s,"eink_live_ok":%s,"consecutive_fails_server":%s,"consecutive_fails_display":%s,"consecutive_fails_eink":%s,"action":"%s","message":"%s"}\n' \
  "$MODE" "$now_iso" "$display_kind" "$server_ok" "$kiosk_ok" "$paint_ok" "$live_ok" "$advance_ok" "$eink_live_ok" "$fails_server" "$fails_display" "$fails_eink" "$action" "$message")"

[ "$action" != "none" ] && logger -t sd-watchdog "$message"
exit 0
