#!/usr/bin/env bash
# sd-setup-boot — first-boot gate for the setup wizard (R1-F1).
#
# If the box is already configured (a real screen-docent.conf exists), do nothing and let the normal
# kiosk boot proceed. Otherwise bring up the "Docent-Setup" Wi-Fi AP + captive portal and run the setup
# wizard so a non-technical user configures the display from their phone — no SSH, no SD-card editing.
#
# Runs as a systemd oneshot (sd-setup.service) BEFORE the kiosk. On commit the wizard writes the conf,
# joins the chosen Wi-Fi, and reboots — the second boot is "configured" and falls through to the kiosk.
#
# ⚠ Pi-gated: the AP bring-up / teardown and Wi-Fi hand-off can only be fully validated on real Pi
# hardware with a flash cycle. The wizard's HTTP/conf logic is verified on the laptop via `--dry-run`.
set -u
# hostapd/dnsmasq/iw/rfkill live in /sbin. systemd normally provides it, but be explicit so this script
# behaves identically when run by hand over SSH (where /sbin is absent from a non-login PATH).
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

SETUP_DIR="/usr/local/share/screen-docent/setup"
# shellcheck source=../setup/common.sh
. "$SETUP_DIR/common.sh"

CONF="$(sd_resolve_conf "${1:-}")"
AP_ADDR="10.0.0.1/24"
# Everything the AP bring-up says goes here — hostapd's own log included. Never /dev/null (ADR-056).
AP_LOG="/var/log/sd-setup-ap.log"

if sd_is_configured "$CONF"; then
  echo "sd-setup-boot: already configured ($CONF) — skipping setup, continuing to kiosk."
  # NOTE: deliberately do NOT touch $AP_LOG here. This unit stays enabled and runs on EVERY boot, so
  # truncating before this check wiped the previous setup attempt's hostapd trace the moment the box
  # rebooted into its configured state — destroying exactly the evidence we need to debug a FAILED
  # setup (caught 2026-07-21, ADR-056). The log is only ever reset when setup actually runs.
  exit 0
fi

echo "sd-setup-boot: no configuration found — starting the Docent-Setup wizard."
# Setup is genuinely running: start a fresh log, but keep the prior attempt alongside it so a gramps
# box that failed setup twice still shows both stories.
[ -s "$AP_LOG" ] && mv -f "$AP_LOG" "$AP_LOG.1" 2>/dev/null
: > "$AP_LOG" 2>/dev/null || AP_LOG=/dev/stderr
echo "sd-setup-boot: $(date -Is) — setup run starting" >>"$AP_LOG"

# --- Bring up the AP + captive portal -------------------------------------------------------------
# The AP bring-up/teardown themselves live in common.sh, shared with sd-net-recover (which re-opens
# this same wizard when a CONFIGURED box can't get online). One copy, one set of bugs.
start_ap() { sd_start_ap "$AP_LOG"; }
stop_ap()  { sd_stop_ap; }

trap stop_ap EXIT

start_ap

# Serve the wizard on port 80 (the captive portal redirects every probe here). The wizard writes the
# conf, joins Wi-Fi, and reboots on commit — so this normally does not return.
/usr/local/bin/sd-setup --port 80 --boot-conf "$CONF"
