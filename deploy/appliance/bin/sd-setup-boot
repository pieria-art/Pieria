#!/usr/bin/env bash
# sd-setup-boot — first-boot gate for the setup wizard (R1-F1).
#
# If the box is already configured (a real pieria.conf exists), do nothing and let the normal
# kiosk boot proceed. Otherwise bring up the "Pieria-Setup" Wi-Fi AP + captive portal and run the setup
# wizard so a non-technical user configures the display from their phone — no SSH, no SD-card editing.
#
# Runs as a systemd oneshot (sd-setup.service) BEFORE the kiosk. On commit the wizard writes the conf,
# joins the chosen Wi-Fi, and reboots — the second boot is "configured" and falls through to the kiosk.
#
# ⚠ Pi-gated: the AP bring-up / teardown and Wi-Fi hand-off can only be fully validated on real Pi
# hardware with a flash cycle. The wizard's HTTP/conf logic is verified on the laptop via `--dry-run`.
set -u
# hostapd/dnsmasq/iw/rfkill live in /sbin. systemd normally provides it, but be explicit so this script
# behaves identically when run by hand over SSH (where /sbin is absent from a non-login PATH).
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

SETUP_DIR="/usr/local/share/pieria/setup"
# shellcheck source=../setup/common.sh
. "$SETUP_DIR/common.sh"

CONF="$(sd_resolve_conf "${1:-}")"
AP_ADDR="10.0.0.1/24"
# Everything the AP bring-up says goes here — hostapd's own log included. Never /dev/null (ADR-056).
AP_LOG="/var/log/sd-setup-ap.log"
# EINK_ENABLED tells us whether this box has a panel to paint the setup card onto.
EINK_ENABLED=0
# shellcheck disable=SC1090
[ -r "$CONF" ] && . "$CONF" 2>/dev/null

if sd_is_configured "$CONF"; then
  echo "sd-setup-boot: already configured ($CONF) — skipping setup, continuing to kiosk."
  # NOTE: deliberately do NOT touch $AP_LOG here. This unit stays enabled and runs on EVERY boot, so
  # truncating before this check wiped the previous setup attempt's hostapd trace the moment the box
  # rebooted into its configured state — destroying exactly the evidence we need to debug a FAILED
  # setup (caught 2026-07-21, ADR-056). The log is only ever reset when setup actually runs.
  exit 0
fi

echo "sd-setup-boot: no configuration found — starting the Pieria-Setup wizard."
# Setup is genuinely running: start a fresh log, but keep the prior attempt alongside it so a gramps
# box that failed setup twice still shows both stories.
[ -s "$AP_LOG" ] && mv -f "$AP_LOG" "$AP_LOG.1" 2>/dev/null
: > "$AP_LOG" 2>/dev/null || AP_LOG=/dev/stderr
echo "sd-setup-boot: $(date -Is) — setup run starting" >>"$AP_LOG"

# --- Bring up the AP + captive portal -------------------------------------------------------------
# The AP bring-up/teardown themselves live in common.sh, shared with sd-net-recover (which re-opens
# this same wizard when a CONFIGURED box can't get online). One copy, one set of bugs.
start_ap() { sd_start_ap "$AP_LOG"; }
stop_ap()  { sd_stop_ap; }

trap stop_ap EXIT

# Tell the HDMI screen it needs setting up. sd-kiosk-launch prefers this file over the normal splash,
# which would otherwise show an admin URL built from the PLACEHOLDER SERVER_URL — a confident, wrong
# address (ADR-058). Written for every box: HDMI is the default surface, e-ink the opt-in one.
#
# WRITTEN BEFORE start_ap, and that ordering is the whole point. sd-setup.service is Type=simple, so
# systemd calls it "started" the instant it forks — `Before=getty@tty1.service` was satisfied 18ms into
# boot, and the kiosk then reached this check ~2s BEFORE start_ap returned and the file appeared. The
# HDMI screen showed the placeholder address for the entire setup (observed 2026-07-22, first full
# gramps run). The splash needs nothing from the AP — it is static instructions plus a QR of the SSID
# NAME — so writing it first removes the dependency instead of racing it.
/usr/local/bin/sd-setup-card --ssid Pieria-Setup --html /run/sd-setup/setup-splash.html >>"$AP_LOG" 2>&1 || true

start_ap

# Tell the E-INK panel it needs setting up. Without this a dumb panel keeps holding its last frame at
# zero power, so an unconfigured box looks finished and working rather than waiting (ADR-058).
#
# Deliberately NOT gated on EINK_ENABLED. A freshly flashed box carries the PLACEHOLDER conf, which has
# no EINK_ENABLED at all — so gating on it meant the card never painted on exactly the out-of-box
# device it exists for. Just attempt it: sd-setup-card imports `inky` lazily and fails harmlessly on a
# box with no panel, and the attempt is logged either way.
# Backgrounded: a full Spectra 6 refresh takes ~9s and must never delay the wizard coming up.
( /usr/local/bin/sd-setup-card --ssid Pieria-Setup >>"$AP_LOG" 2>&1 \
    || echo "sd-setup-boot: no e-ink panel to paint (this is normal on an HDMI-only box)" >>"$AP_LOG" ) &

# Serve the wizard on port 80 (the captive portal redirects every probe here). The wizard writes the
# conf, joins Wi-Fi, and reboots on commit — so this normally does not return.
/usr/local/bin/sd-setup --port 80 --boot-conf "$CONF"
