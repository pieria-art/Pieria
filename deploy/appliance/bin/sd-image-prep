#!/usr/bin/env bash
# sd-image-prep — turn a provisioned appliance into a "golden master" that boots into the first-run
# setup wizard. This is the sysprep step the .img bake needs (install.sh installs sd-setup.service but
# leaves it DISABLED); it is also how the captive-portal wizard tail gets validated in place on a bench
# box with no spare SD card.
#
# Two modes:
#   --enable-setup  (light, reversible, NON-destructive) — enable sd-setup.service + point the boot
#                   conf's SERVER_URL/DISPLAY_ID back at the shipped placeholder pair, so
#                   sd-setup-boot::is_configured() returns false and the NEXT boot enters the wizard
#                   exactly once. Keeps SSH host keys, NetworkManager connections, and the app
#                   database, so you can reconnect and reconcile afterward.
#                   ADR-119: it sets exactly those TWO keys rather than overwriting the whole file.
#                   The GUI now offers this as "move this display to a new Wi-Fi network", and a
#                   wholesale reset would silently discard WATCHDOG, TIMEZONE, EINK_* and
#                   OS_UPDATE_* — settings the owner chose and the wizard never asks about again.
#   --full          (DESTRUCTIVE — for a distributable image capture only) — everything --enable-setup
#                   does, PLUS wipe machine identity (SSH host keys, /etc/machine-id), saved Wi-Fi
#                   (NetworkManager system-connections + Trixie's /etc/netplan), the cloud-init
#                   seed on the boot partition (user-data/network-config/meta-data) + its state, and logs, so the captured .img is clean and
#                   every flashed unit regenerates its own identity. Run this only right before you
#                   power down and capture the card. (The app DB reset, if wanted, is a separate manual
#                   capture-time step — this script never touches Artwork/ or the DB. It DOES empty
#                   data/appliance/ — this box's status files — via sd-mailbox, ADR-131.)
#
# Usage:  sudo sd-image-prep --enable-setup
#         sudo sd-image-prep --full
set -euo pipefail

# --- resolve the boot-partition conf path (same rule as sd-setup-boot / install.sh) ---------------
if [ -d /boot/firmware ]; then BOOT_CONF="/boot/firmware/pieria.conf"; else BOOT_CONF="/boot/pieria.conf"; fi

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
SD_CONF_BIN="${SD_CONF_BIN:-$SCRIPT_DIR/sd-conf}"
[ -x "$SD_CONF_BIN" ] || SD_CONF_BIN="/usr/local/bin/sd-conf"
SD_MAILBOX_BIN="${SD_MAILBOX_BIN:-$SCRIPT_DIR/sd-mailbox}"
[ -x "$SD_MAILBOX_BIN" ] || SD_MAILBOX_BIN="/usr/local/bin/sd-mailbox"
# The shipped placeholder conf, if we can find it (repo layout: ../config/…; installed layout: none).
CONF_EXAMPLE=""
for c in "$SCRIPT_DIR/../config/pieria.conf.example" \
         "/usr/local/share/pieria/pieria.conf.example"; do
  [ -r "$c" ] && { CONF_EXAMPLE="$c"; break; }
done

# Set to 1 by any check that finds credentials/identity that may still ship. Destructive steps keep running
# (they already started), but the POWEROFF step refuses and the script exits 1 — see the end of --full.
PREP_LEAK=0

require_root() {
  if [ "$(id -u)" -ne 0 ]; then echo "Please run as root:  sudo $0 $*" >&2; exit 1; fi
}

# --- send the box back through the wizard WITHOUT losing its settings (--enable-setup) -------------
# sd-setup-boot::sd_is_configured() keys on exactly this SERVER_URL/DISPLAY_ID pair, so writing just
# those two is enough to re-arm the wizard — and leaves everything else in the conf alone.
unconfigure_conf() {
  if [ -x "$SD_CONF_BIN" ]; then
    "$SD_CONF_BIN" --conf "$BOOT_CONF" set \
      SERVER_URL=http://192.168.1.50:8000 DISPLAY_ID=living_room
    echo "  re-armed the wizard in $BOOT_CONF (all other settings preserved)"
  else
    echo "  WARNING: sd-conf not found — falling back to a WHOLESALE conf reset" >&2
    reset_conf_to_placeholder
  fi
}

# --- reset the boot conf to the shipped placeholder (--full only; is_configured() -> false) --------
# A distributable image SHOULD ship the placeholder verbatim: it carries the shipped comments, and
# nothing of this bench box's configuration has any business riding an .img to a stranger's house.
reset_conf_to_placeholder() {
  if [ -n "$CONF_EXAMPLE" ]; then
    install -m 0644 "$CONF_EXAMPLE" "$BOOT_CONF"
    echo "  reset $BOOT_CONF from $CONF_EXAMPLE"
  else
    # No example on disk (installed-only layout) — write the minimal placeholder the gate keys on.
    cat > "$BOOT_CONF" <<'EOF'
# Pieria — Appliance configuration (placeholder; the first-run wizard rewrites this).
SERVER_URL=http://192.168.1.50:8000
DISPLAY_ID=living_room
EOF
    chmod 0644 "$BOOT_CONF"
    echo "  wrote placeholder $BOOT_CONF"
  fi
}

# --- make the placeholder conf describe what this IMAGE can actually do ----------------------------
declare_capabilities() {
  # E-ink is a BAKE-TIME decision: EINK_ENABLED only ever controlled whether install.sh installs and
  # enables sd-eink. The running client never reads it, so a box whose panel is painting happily still
  # reported EINK_ENABLED=0 — because the shipped placeholder says 0 and the wizard faithfully
  # preserves whatever it finds (observed on the first full gramps run, 2026-07-22).
  #
  # Harmless for painting, NOT harmless for updates: sd-update's "Update Scripts" re-runs install.sh,
  # which reads EINK_ENABLED=0 and skips the entire e-ink branch — SPI, i2c-dev, the client install.
  # So an e-ink unit silently stops receiving e-ink provisioning on every update it ever takes.
  #
  # Fix the description at its source: the image declares its own capabilities.
  local want=0
  systemctl is-enabled sd-eink.service >/dev/null 2>&1 && want=1
  if grep -qE "^[[:space:]]*EINK_ENABLED=" "$BOOT_CONF" 2>/dev/null; then
    # Replace only the VALUE token — a trailing `# note` on the line must survive (ADR-137).
    sed -i -E "s/^[[:space:]]*EINK_ENABLED=[^[:space:]#]*/EINK_ENABLED=$want/" "$BOOT_CONF"
  else
    printf '\nEINK_ENABLED=%s\n' "$want" >> "$BOOT_CONF"
  fi
  echo "  declared EINK_ENABLED=$want in $BOOT_CONF (matches sd-eink.service on this image)"
}

enable_setup_service() {
  if ! systemctl list-unit-files sd-setup.service >/dev/null 2>&1; then
    echo "  ERROR: sd-setup.service is not installed — run install.sh first." >&2
    exit 1
  fi
  systemctl enable sd-setup.service
  echo "  enabled sd-setup.service (fires on next boot, then no-ops once configured)"
}

# --- DESTRUCTIVE identity/network/log wipe (--full only) ------------------------------------------
wipe_identity() {
  rm -f /etc/ssh/ssh_host_* 2>/dev/null || true
  # Host keys on a flashed unit come from TWO mechanisms:
  #  1. regenerate_ssh_host_keys.service (UNDERSCORES) — Bookworm: runs once and generates keys. We keep
  #     enabling it (harmless), but it is no longer the gate: on Trixie it carries ConditionFirstBoot=yes
  #     (as does sshd-keygen.service) and never fires, because we leave /etc/machine-id EMPTY and
  #     systemd >=250 does not treat an empty machine-id as first boot. Found on a cold-flashed Trixie
  #     unit: ssh.service crash-looped with "no hostkeys available".
  #  2. The ssh.service drop-in 10-pieria-hostkeys.conf (installed by install.sh) runs `ssh-keygen -A`
  #     before sshd starts, on any distro. THIS is the gate.
  # machine-id stays empty rather than 'uninitialized': true first-boot semantics make systemd run
  # `systemctl preset-all`, which on Debian could re-enable ssh.service and other units we
  # deliberately disable.
  local armed=0 u
  for u in regenerate_ssh_host_keys.service regenerate-ssh-host-keys.service; do
    if systemctl list-unit-files "$u" >/dev/null 2>&1 && systemctl enable "$u" >/dev/null 2>&1; then
      echo "  armed $u (each flashed unit generates its own host keys)"; armed=1; break
    fi
  done
  if [ ! -e /etc/systemd/system/ssh.service.d/10-pieria-hostkeys.conf ]; then
    echo "  WARNING: ssh host-key drop-in missing — flashed units could never start sshd — re-run install.sh" >&2
    PREP_LEAK=1
  elif [ "$armed" != 1 ]; then
    echo "  INFO: could not enable regenerate_ssh_host_keys (expected on Trixie); the ssh.service drop-in generates keys instead"
  fi

  # A DISTRIBUTABLE image must trust nobody. Shipping an authorized_keys means every unit in the world
  # accepts that key — a supply-chain hole, and easy to ship by accident (this master carried the
  # maintainer's laptop key). KEEP_AUTHORIZED_KEYS=1 opts out for a private dev master you intend to
  # SSH into yourself.
  if [ "${KEEP_AUTHORIZED_KEYS:-0}" = "1" ]; then
    echo "  KEPT authorized_keys (KEEP_AUTHORIZED_KEYS=1 — dev master, do NOT distribute this image)"
  else
    local n
    n=$(find /home /root -name authorized_keys 2>/dev/null | wc -l)
    find /home /root -name authorized_keys -delete 2>/dev/null || true
    echo "  removed $n authorized_keys file(s) — the image trusts no one"
  fi

  : > /etc/machine-id
  rm -f /var/lib/dbus/machine-id 2>/dev/null || true
  echo "  wiped SSH host keys + machine-id (regenerate on first boot)"

  # ADR-070: strip the build-time hostname (e.g. the Imager name, or 'pieria-bench-pi') down to the
  # neutral placeholder 'pieria'. sd-hostname turns that into a UNIQUE pieria-XXXX on first boot (from
  # the machine-id we just wiped + regenerated), and the wizard lets the owner name it. Shipping a fixed
  # build hostname means every unit collides on <name>.local and carries a dev name into a stranger's home.
  local oldhost
  oldhost="$(cat /etc/hostname 2>/dev/null || echo '?')"
  echo "pieria" > /etc/hostname 2>/dev/null || true
  if grep -qE '^\s*127\.0\.1\.1' /etc/hosts 2>/dev/null; then
    sed -i 's/^\s*127\.0\.1\.1.*/127.0.1.1\tpieria/' /etc/hosts 2>/dev/null || true
  else
    printf '127.0.1.1\tpieria\n' >> /etc/hosts 2>/dev/null || true
  fi
  echo "  reset hostname '$oldhost' -> 'pieria' placeholder (sd-hostname makes it unique on first boot)"
}

wipe_network() {
  rm -f /etc/NetworkManager/system-connections/* 2>/dev/null || true
  echo "  wiped saved Wi-Fi (NetworkManager system-connections)"
  # NetworkManager's own state names the maintainer's networks (BSSIDs seen, per-connection timestamps,
  # DHCP leases). NM REWRITES seen-bssids/timestamps at shutdown, so this live delete is best-effort;
  # the authoritative scrub is the offline check on the powered-off card (tools/image_leak_check.sh).
  # secret_key is deleted too: it would otherwise be SHARED by every flashed unit, and NM regenerates it
  # when missing. NetworkManager.state is left alone.
  if [ -d /var/lib/NetworkManager ]; then
    find /var/lib/NetworkManager -maxdepth 1 -type f \( -name 'seen-bssids' -o -name 'timestamps' \
      -o -name '*.lease' -o -name '*.leases' -o -name 'internal-*' -o -name 'secret_key' \) -delete 2>/dev/null || true
    echo "  cleared NetworkManager state (seen-bssids, timestamps, leases, secret_key) — best-effort, NM rewrites at shutdown"
  fi
  # Trixie's NetworkManager uses the netplan backend: saved connections (Wi-Fi SSID + PSK included) live
  # as /etc/netplan/90-NM-<uuid>.yaml (cloud-init may add 50-cloud-init.yaml), and system-connections/
  # is empty. Wiping only the latter would ship the maintainer's Wi-Fi PSK and keep the setup-wizard AP
  # from coming up near their network. No-op on Bookworm (no /etc/netplan).
  local nplan=0
  if [ -d /etc/netplan ]; then
    nplan=$(find /etc/netplan -maxdepth 1 -type f \( -name '*.yaml' -o -name '*.yml' \) 2>/dev/null | wc -l)
    find /etc/netplan -maxdepth 1 -type f \( -name '*.yaml' -o -name '*.yml' \) -delete 2>/dev/null || true
  fi
  # Read back — do not trust the rm. Any surviving file that looks like it carries credentials is fatal
  # for a distributable image, same spirit as the host-key warning in wipe_identity.
  local leaked
  leaked=$(grep -rlEi 'psk|password|wifi-security|access-points' /etc/netplan /etc/NetworkManager/system-connections 2>/dev/null || true)
  if [ -d /etc/wpa_supplicant ]; then
    leaked="$leaked
$(grep -lE 'psk=' /etc/wpa_supplicant/*.conf 2>/dev/null || true)"
  fi
  leaked=$(printf '%s\n' "$leaked" | sed '/^$/d')
  if [ -d /var/lib/NetworkManager ]; then
    local nmstate
    nmstate=$(find /var/lib/NetworkManager -maxdepth 1 -type f \( -name 'seen-bssids' -o -name 'timestamps' \) 2>/dev/null || true)
    [ -z "$nmstate" ] || echo "  INFO: NM state still present (NM rewrites at shutdown; image_leak_check.sh --scrub handles it): $(echo $nmstate)"
  fi
  if [ -n "$leaked" ]; then
    echo "  WARNING: Wi-Fi credentials may STILL be on disk — do NOT capture this image:" >&2
    printf '%s\n' "$leaked" | sed 's/^/    /' >&2
    PREP_LEAK=1
  else
    echo "  cleared $nplan netplan file(s); no credential-bearing network config remains"
  fi
}

# --- cloud-init seed + state (--full only) --------------------------------------------------------
# Trixie's Raspberry Pi Imager customisation is cloud-init: user-data (password hash + ssh_authorized_keys),
# network-config (Wi-Fi SSID + PSK) and meta-data stay PERMANENTLY on the FAT boot partition (Bookworm's
# self-deleting firstrun.sh is gone). Left in place they ship the maintainer's credentials in every image.
# cloud-init itself stays ENABLED (Josh's decision, 2026-10-17) so owners can still use Imager's OS
# customisation on our .img — it is the Trixie replacement for userconf.txt. We only clean it.
# No-op (one line) on Bookworm: no cloud-init, no seed files.
wipe_cloud_init() {
  local d f removed="" left="" bootdirs=""
  # Only a MOUNTED boot partition counts: an unmounted /boot/firmware is an empty dir on the rootfs, and
  # "no seed found" there would be a false all-clear.
  for d in /boot/firmware /boot; do
    if mountpoint -q "$d" 2>/dev/null; then
      bootdirs="$bootdirs $d"
    elif [ "$d" = /boot ] && [ -e /boot/cmdline.txt ]; then
      bootdirs="$bootdirs $d"
    fi
  done
  if [ -z "$bootdirs" ]; then
    echo "  WARNING: boot partition not mounted — cannot verify the cloud-init seed is gone; do NOT capture this image" >&2
    PREP_LEAK=1
  fi
  for d in $bootdirs; do
    for f in user-data network-config meta-data; do
      if [ -e "$d/$f" ]; then
        rm -f "$d/$f" 2>/dev/null || true
        removed="$removed $d/$f"
      fi
    done
    # A surviving Bookworm-style firstrun.sh means Imager customisation never finished, so cmdline.txt
    # probably still boots through systemd.run= / kernel-command-line.target. Do NOT delete it — flag it.
    if [ -e "$d/firstrun.sh" ]; then
      echo "  WARNING: $d/firstrun.sh present — Imager first-run never completed — boot this card once more before sysprep" >&2
      PREP_LEAK=1
    fi
    if [ -f "$d/cmdline.txt" ] && grep -q 'systemd\.run=' "$d/cmdline.txt" 2>/dev/null; then
      echo "  WARNING: $d/cmdline.txt still contains systemd.run= (Imager first-run hook) — boot this card once more before sysprep" >&2
      PREP_LEAK=1
    fi
  done
  if command -v cloud-init >/dev/null 2>&1; then
    # --seed drops the NoCloud seed copy, --logs the cloud-init logs, --configs removes ONLY the generated
    # /etc/ssh/sshd_config.d/50-cloud-init.conf and generated netplan. NOT --machine-id (wipe_identity
    # owns that) and NOT --reboot. NOT disabled: no /etc/cloud/cloud-init.disabled.
    if cloud-init clean --logs --seed --configs ssh_config network >/dev/null 2>&1; then
      echo "  cloud-init clean --logs --seed --configs ssh_config network done (cloud-init left enabled)"
    else
      echo "  WARNING: 'cloud-init clean' failed — /var/lib/cloud may still hold the maintainer's instance data" >&2
      PREP_LEAK=1
    fi
    if [ -e /etc/sudoers.d/90-cloud-init-users ]; then
      rm -f /etc/sudoers.d/90-cloud-init-users
      echo "  removed /etc/sudoers.d/90-cloud-init-users"
    fi
  fi
  for d in $bootdirs; do
    for f in user-data network-config meta-data; do
      if [ -e "$d/$f" ]; then left="$left $d/$f"; fi
    done
  done
  if [ -n "$left" ]; then
    echo "  WARNING: cloud-init seed STILL present —$left — the Imager's Wi-Fi password / SSH key would ship; do NOT capture this image" >&2
    PREP_LEAK=1
  elif [ -n "$removed" ]; then
    echo "  removed cloud-init seed from the boot partition:$removed"
  elif ! command -v cloud-init >/dev/null 2>&1; then
    echo "  (no cloud-init and no seed files — nothing to clean)"
  else
    echo "  (no cloud-init seed files on the boot partition)"
  fi
}

# --- kiosk Chromium profile: no build-box browser state on a distributable image (--full only) ------
# ADR-083: a captured image can carry the kiosk user's Chromium profile — SingletonLock/Cookie/Socket
# from a browser that was still running when this script powered off, plus cache and history that have
# no business riding to a stranger's house. sd-kiosk-launch clears a stale lock at every relaunch, but
# an image should still ship with no profile at all rather than lean on that runtime guard.
KIOSK_USER="${KIOSK_USER:-kiosk}"

_kiosk_home() {
  getent passwd "$KIOSK_USER" 2>/dev/null | cut -d: -f6
}

wipe_kiosk_chromium_profile() {
  local home profile
  home="$(_kiosk_home)"
  [ -n "$home" ] || return 0   # no kiosk user on this box — nothing to wipe

  # Stop the kiosk FIRST: this runs on a live box, and the kiosk loop relaunches Chromium within 3s of
  # any exit — which would write a fresh build-host SingletonLock straight back after the wipe. Stop
  # the autologin getty (so nothing respawns the session), then end the kiosk user's processes; TERM
  # first so Chromium can release its own lock. getty@tty1 stays enabled — it starts on the next boot.
  systemctl --no-ask-password stop getty@tty1.service 2>/dev/null || true
  pkill -TERM -u "$KIOSK_USER" 2>/dev/null || true
  sleep 3
  pkill -KILL -u "$KIOSK_USER" 2>/dev/null || true

  profile="$home/.config/chromium"
  [ -e "$profile" ] || return 0

  case "$profile" in
    */.config/chromium) ;;
    *) echo "  WARNING: kiosk Chromium profile path '$profile' looks wrong — refusing to remove it" >&2
       return 0 ;;
  esac

  if [ -L "$profile" ]; then
    echo "  WARNING: $profile is a symlink — refusing to follow it out of the profile dir" >&2
    return 0
  fi

  if [ -d "$profile" ] && [ -n "$(find "$profile" -mindepth 1 -print -quit 2>/dev/null)" ]; then
    rm -rf --one-file-system "$profile"
    echo "  removed kiosk Chromium profile ($profile) — no build-box browser state (locks/cache/history) ships"
  fi
}

# --- resolve the app repo root (install.sh baked it into sd-app.service) --------------------------
repo_root() {
  local r
  r="$(systemctl show -p WorkingDirectory --value sd-app.service 2>/dev/null || true)"
  [ -n "$r" ] && [ -d "$r" ] && { echo "$r"; return 0; }
  for d in /home/*/Pieria /root/Pieria; do
    [ -d "$d" ] && { echo "$d"; return 0; }
  done
  return 1
}

# --- secrets that must NEVER ride a distributable image (--full only) -----------------------------
wipe_secrets() {
  # The same class of mistake as shipping authorized_keys: a secret that is invisible on the bench and
  # is then copied to every unit in the world. Two carriers, both easy to miss because neither lives
  # anywhere you'd think to look at capture time.
  local root
  if ! root="$(repo_root)"; then
    echo "  WARNING: could not locate the app repo — CHECK .env AND the database for keys by hand" >&2
    return 0
  fi

  # 1) .env — install.sh writes GEMINI_API_KEY here when one is passed. TRUNCATE, never delete: the
  #    compose file declares `env_file: .env`, and docker compose fails outright if it is missing.
  if [ -s "$root/.env" ]; then
    ( umask 077; : > "$root/.env" )
    echo "  emptied $root/.env (it held a key — that would have shipped to every unit)"
  else
    echo "  .env already empty"
  fi

  # 2) sd-update's F3 rollback snapshot — a full copy of artwork.db taken mid-update, including
  #    whatever AI API key was stored at the time. sd-update deletes it itself when an update arm
  #    finishes, but a box captured mid-update (or from an older sd-update that didn't clean up) could
  #    still have one lying around. Deleted HERE, before the key-check loop below: a stored key inside
  #    this stray snapshot would otherwise make that loop refuse (exit 1) on data/appliance/*.db before
  #    this deletion ever ran, and the loop's printed remediation (`rm -rf $root/data/*.db*`) doesn't
  #    reach data/appliance/ anyway.
  local snap="$root/data/appliance/pre-update.db"
  if [ -f "$snap" ]; then
    rm -f "$snap"
    echo "  removed $snap (a stray update rollback snapshot — it could hold a stored API key)"
  fi

  # 3) The database — a key entered in Admin -> AI Engine is stored as the `ai_api_key` setting, and
  #    it takes PRECEDENCE over the env var (ai_client.py). Capturing a DB you smoke-tested with is
  #    therefore enough to leak it. Refuse rather than silently deleting someone's library.
  # GLOB, don't hardcode a filename. The first cut of this check looked for `pieria.db`; the
  # app actually uses `data/artwork.db` (database.py), so it printed a confident "DB: absent" while a
  # real database sat right there. A check that reports a false all-clear is worse than no check.
  # Globbing also survives an SD_DATABASE_URL override and any future rename.
  local checked=0 db found
  shopt -s nullglob
  for db in "$root"/data/*.db; do
    checked=1
    if ! command -v python3 >/dev/null 2>&1; then
      echo "  WARNING: python3 missing — could not check $db for stored API keys" >&2
      continue
    fi
    found="$(python3 - "$db" <<'PY' 2>/dev/null || true
import sqlite3, sys
try:
    c = sqlite3.connect(f"file:{sys.argv[1]}?mode=ro", uri=True)
    r = c.execute("select count(*) from settings where setting_key in "
                  "('ai_api_key','museum_api_key') and coalesce(setting_value,'') != ''").fetchone()
    print(r[0] if r else 0)
except Exception:
    print("?")   # unreadable/no settings table -> treat as unknown, not as clean
PY
)"
    if [ "$found" = "0" ]; then
      echo "  $(basename "$db") carries no stored API keys"
    else
      echo >&2
      echo "  REFUSING TO CONTINUE: $db reports stored API keys ($found)." >&2
      echo "  A distributable image must ship no keys — the end user supplies their own in" >&2
      echo "  Admin -> AI Engine. Clear the database first (this also makes first boot exercise" >&2
      echo "  the real out-of-box R2 pull):" >&2
      echo "      cd $root && docker compose -f docker-compose.yml \\" >&2
      echo "        -f deploy/appliance/compose/docker-compose.appliance.yml down" >&2
      echo "      sudo rm -rf $root/data/*.db* $root/Artwork/*" >&2
      exit 1
    fi
  done
  shopt -u nullglob
  [ "$checked" = 1 ] || echo "  no database present (correct for a capture)"

  # An image is supposed to ship EMPTY and pull from R2. Art left in place is not a security problem,
  # but it silently adds gigabytes to something you are about to distribute — say so.
  if [ -d "$root/Artwork" ]; then
    local n
    n=$(find "$root/Artwork" -type f ! -name '.*' 2>/dev/null | wc -l)
    if [ "$n" -gt 0 ]; then
      echo "  NOTE: Artwork/ still holds $n file(s), $(du -sh "$root/Artwork" 2>/dev/null | cut -f1) —" \
           "the captured image will carry them. Clear it first if you meant to ship empty."
    fi
  fi
}

# --- quiesce everything that writes status files or holds the apt/dpkg lock (--full only) ----------
# Runs FIRST in --full, before anything destructive, because it can abort. STOP, never disable: the
# timers must stay enabled so every flashed unit starts them at its first boot. An OS upgrade (or the
# nightly check, which shares the apt lock) is NEVER killed mid-run — killing dpkg corrupts the image
# being captured — so if one is running we refuse and the operator re-runs once it has finished.
APT_LOCK_FILE="${SD_LOCK_FILE:-/run/lock/pieria-apt.lock}"

quiesce_status_writers() {
  local t svc
  local timers="sd-watchdog.timer sd-metrics.timer sd-os-check.timer sd-quiet-hours.timer sd-os-upgrade.timer"
  for t in $timers; do
    systemctl --no-ask-password stop "$t" 2>/dev/null || true
  done

  local busy=""
  for svc in sd-os-upgrade.service sd-os-check.service; do
    systemctl is-active --quiet "$svc" 2>/dev/null && busy="$busy $svc"
  done
  # The shared apt flock: held by update-system / sd-os-check / sd-os-upgrade. Test without creating it.
  if [ -e "$APT_LOCK_FILE" ] && ! flock -n "$APT_LOCK_FILE" true 2>/dev/null; then
    busy="$busy (apt lock $APT_LOCK_FILE held)"
  fi
  if [ -n "$busy" ]; then
    echo "  ERROR: an OS upgrade is running —$busy" >&2
    echo "         wait for it to finish, then re-run. Nothing was cleared." >&2
    exit 1
  fi

  # Everything else may be stopped if it is mid-run (they only write status JSON).
  for t in $timers; do
    svc="${t%.timer}.service"
    case "$svc" in sd-os-upgrade.service|sd-os-check.service) continue ;; esac
    if systemctl is-active --quiet "$svc" 2>/dev/null; then
      systemctl --no-ask-password stop "$svc" 2>/dev/null || true
    fi
  done
  echo "  stopped the status-writing timers + any running service (timers left ENABLED for first boot)"
}

# --- this box's status files must not ride the image (--full only) --------------------------------
# data/appliance/ holds conf.json / watchdog / metrics / update-check — state that describes THIS build
# box and would be shown to a stranger until first boot regenerates it. The container (uid 1000) can
# swap anything inside data/ for a symlink, so root goes through sd-mailbox (ADR-131: O_NOFOLLOW
# dir-fd), never `rm data/appliance/*` by path. Run after wipe_secrets so a refusal there aborts first.
clear_appliance_status() {
  local root n
  if ! root="$(repo_root)"; then
    echo "  WARNING: could not locate the app repo — empty data/appliance/ by hand" >&2
    return 0
  fi
  if [ ! -d "$root/data" ]; then
    echo "  no $root/data — nothing to clear in data/appliance"
    return 0
  fi
  if [ ! -x "$SD_MAILBOX_BIN" ]; then
    echo "  ERROR: sd-mailbox not found — cannot safely clear data/appliance (run install.sh)" >&2
    exit 1
  fi
  if ! n="$("$SD_MAILBOX_BIN" --repo-root "$root" --dir appliance clear)"; then
    echo "  ERROR: sd-mailbox could not clear data/appliance — refusing to capture with its status files" >&2
    exit 1
  fi
  echo "  cleared data/appliance/ ($n file(s)) — status files regenerate on first boot"
}

# --- remote login: no shared credentials on a distributed image (--full only) ---------------------
lock_login() {
  # The third leg of the same problem as SSH host keys and authorized_keys. A public image means every
  # unit in the world shares whatever login it was baked with — exactly the pi/raspberry default-password
  # problem the Raspberry Pi Foundation spent years killing. Host-key regeneration and authorized_keys
  # removal do nothing about a PASSWORD.
  #
  # We cannot delete the build user: the app lives in its home directory (/home/<user>/Pieria)
  # and sd-app.service runs docker compose from there. The account must exist to own files — it just
  # must not be able to log in. So: lock the password, leave the account.
  #
  # KEEP_LOGIN=1 opts out for a bench image you intend to SSH into (the same escape hatch as
  # KEEP_AUTHORIZED_KEYS). Never for a distributable one.
  if [ "${KEEP_LOGIN:-0}" = "1" ]; then
    echo "  KEPT login + SSH (KEEP_LOGIN=1 — bench image, do NOT distribute)"
    return 0
  fi

  # Disable password login for every human account (uid >= 1000, excluding nobody) AND destroy the hash.
  # `passwd -l` only prefixes '!' and leaves the real hash in /etc/shadow — every public .img would carry
  # the maintainer's crackable password hash. `usermod -p '!*'` replaces it; the account keeps working for
  # file ownership and console autologin.
  local locked="" user uid shadowpw
  while IFS=: read -r user _ uid _ _ _ _; do
    [ "$uid" -ge 1000 ] 2>/dev/null || continue
    [ "$uid" -ge 65534 ] && continue
    if usermod -p '!*' "$user" >/dev/null 2>&1; then locked="$locked $user"; fi
    shadowpw=$(awk -F: -v u="$user" '$1==u{print $2}' /etc/shadow 2>/dev/null || true)
    if [ "$shadowpw" != '!*' ]; then
      echo "  WARNING: /etc/shadow hash for '$user' was NOT destroyed — the password hash would ship; do NOT capture this image" >&2
      PREP_LEAK=1
    fi
  done < /etc/passwd
  echo "  destroyed password hash (set to '!*', login disabled) for:${locked:- (none found)}"

  # SSH off by default. This MATCHES the platform: Raspberry Pi OS Lite ships sshd disabled unless you
  # enable it, and the escape hatch is a well-known idiom — drop an empty file named `ssh` on the FAT
  # boot partition (handled by raspberrypi-sys-mods' sshswitch) and it comes back on next boot. Set
  # credentials: on Bookworm a `userconf.txt`; on Trixie `userconfig.service` is masked and the route is
  # a hand-written cloud-init `user-data` (+ `meta-data`) on the boot partition (Imager greys out its OS
  # customisation for custom images) — see docs/image-build.md#remote-access-on-a-shipped-unit. Both work from any computer with a card reader, so
  # a technical owner is never locked out, and a non-technical one has no exposed service at all.
  # The appliance's real management surface is the web admin UI, not a terminal.
  if systemctl disable --now ssh >/dev/null 2>&1 || systemctl disable --now sshd >/dev/null 2>&1; then
    echo "  disabled sshd (re-enable per unit: put an empty file named 'ssh' on the boot partition)"
  else
    echo "  (no ssh unit to disable)"
  fi
}

# --- clock floor for the captured image (--full only) ---------------------------------------------
stamp_clock() {
  # ADR-062. A Pi has no battery-backed clock, so `fake-hwclock` restores a saved timestamp at boot and
  # every unit flashed from this image will believe it is the moment we capture right now. Two things
  # follow, and both matter for a DISTRIBUTED image:
  #
  #   * Write the floor as LATE as possible. It only ever moves the clock forward (fake-hwclock takes
  #     max(saved, current)), so the newest honest value is the best one: it minimises how far in the
  #     past a flashed unit starts, and starting at the real 1970 epoch fails TLS far worse.
  #   * Never write a FUTURE date to "buy margin". That trades a `notBefore` failure for a `notAfter`
  #     one and breaks TLS from the other end. The real fix is NTP before the network is used, which
  #     is sd-timesync-wait.service's job — this is only the floor before NTP lands.
  if command -v fake-hwclock >/dev/null 2>&1; then
    fake-hwclock save 2>/dev/null || true
    echo "  stamped the fake-hwclock floor: $(cat /etc/fake-hwclock.data 2>/dev/null || echo unknown) UTC"
  else
    echo "  WARNING: fake-hwclock not installed — flashed units will boot at the 1970 epoch and ALL" >&2
    echo "           HTTPS will fail until NTP lands. Install it before capturing a shippable image." >&2
  fi
  if ! systemctl is-enabled sd-timesync-wait.service >/dev/null 2>&1; then
    echo "  WARNING: sd-timesync-wait.service is not enabled — a unit flashed months from now may fail" >&2
    echo "           TLS to the art registry on a stale clock (ADR-062). Re-run install.sh." >&2
  fi
}

clean_logs() {
  journalctl --rotate 2>/dev/null || true
  journalctl --vacuum-time=1s 2>/dev/null || true
  find /var/log -type f -exec truncate -s 0 {} + 2>/dev/null || true
  rm -f /home/*/.bash_history /root/.bash_history 2>/dev/null || true
  echo "  cleaned logs + shell history"
}

case "${1:-}" in
  --enable-setup)
    require_root "$@"
    echo "==> sd-image-prep: enable-setup (light, reversible)"
    unconfigure_conf
    declare_capabilities
    enable_setup_service
    echo "Done. Reboot to enter the Pieria-Setup wizard. (Undo: write a real conf, or"
    echo "'systemctl disable sd-setup.service'.)"
    ;;
  --full)
    require_root "$@"
    echo "==> sd-image-prep: FULL (destructive — for a distributable image capture)"
    # `sudo -i` also sets SUDO_USER; only nag a direct `sudo sd-image-prep` call.
    if [ -n "${SUDO_USER:-}" ] && [ -z "${SUDO_COMMAND##*sd-image-prep*}" ]; then
      echo "NOTE: invoked via sudo — prefer 'sudo -i' first and run this from the root shell: lock_login destroys your password hash, so a refused poweroff would leave you without sudo."
    fi
    quiesce_status_writers   # can abort (an OS upgrade is running) — before anything destructive
    wipe_secrets  # this can abort too, and it should abort before anything destructive happens
    clear_appliance_status
    reset_conf_to_placeholder
    declare_capabilities
    enable_setup_service
    wipe_network
    wipe_cloud_init
    wipe_identity
    lock_login
    wipe_kiosk_chromium_profile
    clean_logs
    stamp_clock   # last: the floor should be as late as possible (see ADR-062)
    if [ "$PREP_LEAK" = "1" ]; then
      {
        echo
        echo "=============================================================================="
        echo "NOT powering off: credentials may remain — fix and re-run; do not capture."
        echo "You need a root shell to re-run (sudo will no longer work for a password-only user:"
        echo "lock_login destroyed the password hash)."
        echo "Scroll up for the WARNING lines. The destructive steps already ran; re-running"
        echo "--full is safe. Do NOT dd this card until a run finishes with no WARNING."
        echo "=============================================================================="
      } >&2
      exit 1
    fi
    echo "Done. Power down now and capture the card (dd -> pishrink -> xz). Do NOT reboot this box"
    echo "on the bench — it would regenerate identity here instead of on the flashed units."
    # --full deletes the SSH host keys, so this command destroys its own remote access: any shutdown
    # has to happen in the SAME invocation or the box can only be powered off by pulling the plug,
    # which images a dirty ext4 journal into every flashed unit (learned the hard way 2026-07-21).
    if [ "${POWEROFF:-0}" = "1" ]; then
      echo "Syncing and powering off now (POWEROFF=1)."
      sync
      exec systemctl poweroff
    else
      echo
      echo "TIP: re-run with POWEROFF=1 to sync + shut down in one step — after this command SSH is"
      echo "     already dead (host keys are gone), so you cannot cleanly shut down remotely."
    fi
    ;;
  --help|-h|"")
    sed -n '2,30p' "$0" | sed 's/^# \{0,1\}//'
    ;;
  *)
    echo "Unknown option: $1" >&2
    echo "Usage: sudo $0 --enable-setup | --full   (see --help)" >&2
    exit 2
    ;;
esac
