#!/usr/bin/env bash
# sd-net-recover — the "can't be bricked" backstop (ADR-057).
#
# THE HOLE THIS FILLS: the first-run wizard saves the Wi-Fi profile and reboots, trusting NetworkManager
# to auto-join it. If the user mistyped the password (or picked a neighbour's SSID), the box comes back
# CONFIGURED — so sd-setup-boot's is_configured() check makes it no-op — with no network, no AP, and no
# wizard. Nothing in the appliance noticed. Recovery meant pulling the SD card and editing it on a
# computer, which for the target user means the device is dead. That directly contradicts the product's
# "can't be bricked" promise.
#
# WHAT IT DOES: watches for a sustained lack of network on a configured box and, when it sees one,
# re-opens the SAME wizard behind the SAME Pieria-Setup AP with a banner explaining why. The user
# retypes the password from their phone. Nothing is destroyed — their existing config stays on disk and
# is simply rewritten on commit.
#
# WHY IT CAN USE PLAIN nmcli (unlike sd-setup-pre): the NetworkManager race that ADR-056 fixed exists
# only during early boot, when NM is mid-autoconnect. This runs long after NM has settled, so runtime
# `nmcli` calls are authoritative here.
set -u
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

SETUP_DIR=/usr/local/share/pieria/setup
# shellcheck source=../setup/common.sh
. "$SETUP_DIR/common.sh"

CONF="$(sd_resolve_conf "${1:-}")"
LOG=/var/log/sd-net-recover.log
say() { echo "sd-net-recover: $*"; }

# Knobs, overridable from pieria.conf.
NET_RECOVER=on            # off disables the backstop entirely
NET_RECOVER_GRACE=120     # seconds offline after BOOT before we intervene
NET_RECOVER_SUSTAINED=900 # seconds offline AFTER we've been online once (avoids reacting to a blip)
NET_RECOVER_WINDOW=600    # how long the recovery AP stays up per attempt
NET_RECOVER_RETRY_GAP=300 # how long NM gets to reconnect on its own between attempts
ALL_IN_ONE=0
EINK_ENABLED=0
WIFI_DEV=wlan0
# shellcheck disable=SC1090
[ -r "$CONF" ] && . "$CONF" 2>/dev/null

if ! sd_is_configured "$CONF"; then
  say "not configured — sd-setup-boot owns this box, nothing to recover."
  exit 0
fi
if [ "${NET_RECOVER}" = "off" ]; then
  say "disabled via NET_RECOVER=off."
  exit 0
fi

# Whatever happens (including SIGTERM from systemd), never leave the radio held hostage.
cleanup() { sd_stop_ap "${RECOVER_PROFILE:-}" >/dev/null 2>&1; }
trap cleanup EXIT

# Bash defers a trap until the CURRENT foreground command finishes, so a plain `sleep 300` would swallow
# SIGTERM for the rest of its run — systemd then hit TimeoutStopSec and SIGKILLed us, adding 45s to
# every reboot AND skipping the cleanup that returns wlan0 to NetworkManager (found on hardware
# 2026-07-21). Sleep in the BACKGROUND and `wait` on it: wait IS interruptible, so the handler runs at
# once and we exit promptly with the radio handed back.
TERMINATING=0
SLEEP_PID=""
on_term() { TERMINATING=1; [ -n "$SLEEP_PID" ] && kill "$SLEEP_PID" 2>/dev/null; }
trap on_term TERM INT

_sleep() {
  sleep "$1" & SLEEP_PID=$!
  wait "$SLEEP_PID" 2>/dev/null
  SLEEP_PID=""
  [ "$TERMINATING" = 1 ] && { say "stopping on signal"; exit 0; }
  return 0
}

say "watching ${WIFI_DEV} (grace ${NET_RECOVER_GRACE}s, sustained ${NET_RECOVER_SUSTAINED}s)"

STEP=15
offline=0
threshold="$NET_RECOVER_GRACE"   # tighter right after boot; relaxes once we've seen the network work

while true; do
  if sd_have_ip "$WIFI_DEV"; then
    [ "$offline" -gt 0 ] && say "back online after ${offline}s"
    offline=0
    # We have proof the network works, so from here on only a LONG outage justifies stealing the radio
    # — a router reboot at 3am must not pop a setup portal over someone's artwork.
    threshold="$NET_RECOVER_SUSTAINED"
    _sleep "$STEP"
    continue
  fi

  offline=$((offline + STEP))
  if [ "$offline" -lt "$threshold" ]; then
    _sleep "$STEP"
    continue
  fi

  # --- Intervene ---------------------------------------------------------------------------------
  say "offline for ${offline}s — re-opening the setup wizard on the Pieria-Setup AP"
  : > "$LOG" 2>/dev/null || true
  # Remember which profile to reactivate if the user never shows up.
  RECOVER_PROFILE="$(nmcli -t -f NAME,TYPE con show 2>/dev/null | awk -F: '$2 ~ /wireless/ {print $1; exit}')"

  if sd_start_ap "$LOG"; then
    /usr/local/bin/sd-setup-card --ssid Pieria-Setup --recovery \
      --html /run/sd-setup/setup-splash.html >>"$LOG" 2>&1 || true
    # Same reasoning as first-run setup: the panel is holding art and looks fine, so say what's wrong
    # ON THE GLASS. The recovery variant is red and leads with "Couldn't join your Wi-Fi" (ADR-058).
    ( /usr/local/bin/sd-setup-card --ssid Pieria-Setup --recovery >>"$LOG" 2>&1 \
        || echo "sd-net-recover: no e-ink panel to paint" >>"$LOG" ) &
    EXTRA=()
    [ "${ALL_IN_ONE}" = "1" ] && EXTRA+=(--all-in-one)
    # `timeout` bounds the attempt. On a successful commit the wizard reboots the box, so this call
    # normally never returns at all.
    rc=0
    timeout "$NET_RECOVER_WINDOW" /usr/local/bin/sd-setup --port 80 --boot-conf "$CONF" \
      --recovery "This display couldn't join your Wi-Fi. Check the network name and password, then try again." \
      "${EXTRA[@]}" || rc=$?
    [ "$TERMINATING" = 1 ] && exit 0
    if [ "$rc" -eq 124 ]; then
      say "recovery window expired with no commit — returning the radio to NetworkManager"
    else
      # A successful commit reboots the box, which SIGTERMs us mid-wizard — reporting that as
      # "no commit" was actively misleading in the logs of the run that actually SUCCEEDED.
      say "wizard exited (rc=$rc); if it committed, a reboot is already scheduled"
    fi
  else
    say "could not raise the recovery AP (see $LOG) — will retry"
  fi

  sd_stop_ap "$RECOVER_PROFILE"
  unset RECOVER_PROFILE
  # Give NetworkManager an uncontended shot at reconnecting before we consider intervening again;
  # the original problem may simply have been the router being slower than us.
  say "giving NetworkManager ${NET_RECOVER_RETRY_GAP}s to reconnect on its own"
  _sleep "$NET_RECOVER_RETRY_GAP"
  offline=0
done
