# Screen Docent — Appliance configuration
#
# Edit this file on the SD card's boot partition (visible as a small FAT
# volume on any computer after flashing), then reboot the Pi. No SSH needed.
#
# Lines are KEY=VALUE and are sourced by the kiosk launcher as shell variables.

# URL of your Screen Docent server (the box running `docker compose up`).
# For ALL_IN_ONE mode (below), point this at this box: http://localhost:8000
SERVER_URL=http://192.168.1.50:8000

# A unique name for THIS display. It appears in the mobile remote's
# "Target Display" dropdown, so make it memorable (e.g. living_room, hallway).
DISPLAY_ID=living_room

# --- Optional overrides (leave blank to use the playlist / server defaults) ---

# MODE: ken-burns | static-crop | contain-matte
MODE=

# CYCLE_TIME: seconds per image
CYCLE_TIME=

# ROTATE: display orientation. Most panels are landscape — leave blank for that.
# For a TV physically mounted in PORTRAIT, set 90 or 270 (try one; if the picture
# is upside-down, use the other). 180 flips a landscape panel. Rotation is done at
# the compositor, so the image stays pixel-exact — also set the TV's OWN orientation
# to Landscape/Normal and Picture Size to "Just Scan" so it passes the signal 1:1.
# Values: 90 | 180 | 270   (blank = normal landscape)
ROTATE=

# OUTPUT: which HDMI port ROTATE applies to (ignored if ROTATE is blank).
# HDMI-A-1 is the port nearest the USB-C power on a Pi 5; HDMI-A-2 is the other.
OUTPUT=HDMI-A-1

# How long (seconds) to wait for the server at boot before launching the
# browser anyway. 0 = wait forever (the screen stays black until the server is
# reachable, then paints automatically). Recommended: 0 for a home server.
WAIT_TIMEOUT=0

# WATCHDOG: kiosk/server self-heal (all-in-one). On sustained failure it escalates
# relaunch-kiosk -> restart-container -> reboot (with a boot-loop guard).
#   observe  = probe + log what it WOULD do, take NO action (default; safe to leave on)
#   enforce  = actually self-heal (set this once you've confirmed it on YOUR hardware)
#   off      = disabled
WATCHDOG=observe

# --- All-in-one mode (optional) -------------------------------------------
# Set ALL_IN_ONE=1 to ALSO run the Screen Docent server on THIS box via Docker
# (one box = server + display). Then set SERVER_URL=http://localhost:8000 above.
# Leave 0 for the normal thin-client setup (server lives elsewhere, e.g. MS-01).
ALL_IN_ONE=0

# Gemini API key — required for AI features when ALL_IN_ONE=1 (ignored otherwise).
# Get one at https://aistudio.google.com/. NOTE: this file sits on a FAT boot
# partition, so anyone with the SD card can read this key.
GEMINI_API_KEY=
