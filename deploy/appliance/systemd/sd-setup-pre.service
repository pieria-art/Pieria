# Installed AND ENABLED by install.sh on every box (unlike sd-setup.service, which only the .img
# enables). It is safe everywhere: on a configured box it only ever REMOVES a stale drop-in, and it
# refuses to unmanage wlan0 unless sd-setup.service is actually enabled. Keeping it always-on is what
# makes the setup-mode radio hand-off self-healing — see sd-setup-pre and ADR-056.
# __BOOT_CONF__ is substituted by install.sh with the boot-partition conf path.
[Unit]
Description=Screen Docent — claim wlan0 for setup before NetworkManager starts
Documentation=man:NetworkManager.conf(5)
# Must run before NM reads its configuration, so the drop-in is already in place on NM's first look at
# the radio. DefaultDependencies=no + sysinit.target puts us in early boot; local-fs gives us /etc and
# the boot partition (where screen-docent.conf lives).
DefaultDependencies=no
After=local-fs.target
Before=NetworkManager.service network-pre.target shutdown.target
Wants=network-pre.target
Conflicts=shutdown.target
ConditionPathExists=/usr/local/bin/sd-setup-pre

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/sd-setup-pre __BOOT_CONF__
# Never block boot on this: a failure here must not strand the box before the network comes up.
SuccessExitStatus=0 1

[Install]
WantedBy=sysinit.target
