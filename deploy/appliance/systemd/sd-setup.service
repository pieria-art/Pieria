# Installed by install.sh as /etc/systemd/system/sd-setup.service, but ENABLED only on a freshly baked
# .img (never enabled by install.sh on an already-running box). On first boot it runs sd-setup-boot,
# which no-ops if the box is already configured, else brings up the Pieria-Setup AP + wizard.
# __BOOT_CONF__ is substituted by install.sh with the boot-partition conf path.
[Unit]
Description=Pieria first-run setup wizard (captive portal)
# Run before the kiosk.
Before=getty@tty1.service
# MUST start AFTER NetworkManager, not before it. NM owns wlan0; if we bring up the setup AP first, NM
# starts a moment later, ignores our earlier "managed no", and auto-connects any saved Wi-Fi — stomping
# the AP dead (bench-day finding 2026-07-19). Ordering after NM lets sd-setup-boot authoritatively
# disconnect + unmanage wlan0 with NM already up, and the wizard needs NM anyway to save Wi-Fi at commit.
Wants=NetworkManager.service
After=NetworkManager.service

[Service]
Type=simple
ExecStart=/usr/local/bin/sd-setup-boot __BOOT_CONF__
# The wizard reboots on commit; if it exits without configuring, don't spin.
Restart=no

[Install]
WantedBy=multi-user.target
