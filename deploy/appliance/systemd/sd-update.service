# Installed by install.sh (all-in-one only) as:
#   /etc/systemd/system/sd-update.service
#
# Runs the whitelisted host-side updater when sd-update.path fires. Root oneshot —
# this is the ONLY component with host privilege; the web app never gets it.
# __REPO_ROOT__ is substituted by install.sh.
[Unit]
Description=Pieria appliance updater (git pull / rebuild / scripts / reboot)

[Service]
Type=oneshot
ExecStart=/usr/local/bin/sd-update __REPO_ROOT__
