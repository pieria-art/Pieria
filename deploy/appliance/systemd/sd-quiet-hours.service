# Installed by install.sh (all-in-one only) as:
#   /etc/systemd/system/sd-quiet-hours.service
#
# Oneshot that powers the HDMI-CEC panel off/on to match the app's Night & Quiet Hours
# schedule (only when quiet_mode=cec; the software blackout covers the rest). Triggered
# by sd-quiet-hours.timer. __BOOT_CONF__ is substituted by install.sh with the appliance
# config path (SERVER_URL + DISPLAY_ID).
[Unit]
Description=Screen Docent quiet-hours HDMI-CEC panel power

[Service]
Type=oneshot
ExecStart=/usr/local/bin/sd-quiet-hours __BOOT_CONF__
