# Installed by install.sh (all-in-one only) as:
#   /etc/systemd/system/sd-update.path
#
# Watches the bind-mounted request file the container writes when the admin GUI asks
# for an update; triggers sd-update.service. __REPO_ROOT__ is substituted by install.sh.
[Unit]
Description=Watch for Pieria appliance update requests

[Path]
PathChanged=__REPO_ROOT__/data/appliance/request.json
Unit=sd-update.service

[Install]
WantedBy=multi-user.target
