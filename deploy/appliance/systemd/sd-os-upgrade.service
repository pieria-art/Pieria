# Installed by install.sh (all-in-one only) as:
#   /etc/systemd/system/sd-os-upgrade.service
#
# The weekly unattended OS upgrade, if the owner opted in. It only QUEUES the same request the GUI
# button writes — sd-update does the work — so scheduled and manual upgrades share one code path.
# __BOOT_CONF__ and __REPO_ROOT__ are substituted by install.sh.
[Unit]
Description=Pieria weekly OS upgrade (opt-in)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/sd-os-schedule __BOOT_CONF__ __REPO_ROOT__
