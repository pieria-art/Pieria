# Version control / CI
.git/
.github/

# Secrets & local env (never bake into the image)
.env

# Python runtime cruft
venv/
.venv/
__pycache__/
*.py[cod]

# Data & media (provided via volumes at runtime, not baked in)
*.db
artwork.db
data/
Artwork/

# Built art-packs + per-collection slices — huge distributables (R2/.img), never the dev image context.
art-pack/
art-pack-*/

# Maintainer build pipeline — NOT imported at runtime (ADR-041). The catalog is built here and
# shipped as static/catalog/*.json; the app imports only top-level scout.py (live museum search),
# never tools/. Keep it out of the image (dead weight + smaller attack surface).
tools/

# Dev tooling, tests, coverage
tests/
requirements-dev.txt
.coverage
.pytest_cache/
.playwright-mcp/

# Editor / assistant local state & internal docs (not needed at runtime)
.claude/
.ai/
PRD.md
